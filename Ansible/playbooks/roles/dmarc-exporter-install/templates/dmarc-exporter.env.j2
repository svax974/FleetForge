# Configuration de l'exporter DMARC — géré par Ansible, ne pas éditer à la main.
# Contient le mot de passe IMAP : mode 0600, lisible du seul utilisateur du service.
DMARC_LISTEN_PORT={{ dmarc_exporter_port }}
DMARC_STATE_FILE={{ dmarc_exporter_state_dir }}/state.json
DMARC_IMAP_HOST={{ dmarc_exporter_imap_host }}
DMARC_IMAP_PORT={{ dmarc_exporter_imap_port }}
DMARC_IMAP_USER={{ dmarc_exporter_imap_user }}
DMARC_IMAP_PASSWORD={{ dmarc_exporter_imap_password }}
DMARC_IMAP_FOLDER={{ dmarc_exporter_imap_folder }}
DMARC_RUA_ADDRESSES={{ dmarc_exporter_rua_addresses | join(',') }}
DMARC_SEARCH_SUBJECT={{ dmarc_exporter_search_subject | string | lower }}
DMARC_TRUSTED_SENDER_DOMAINS={{ dmarc_exporter_trusted_sender_domains | join(',') }}
DMARC_POLL_INTERVAL={{ dmarc_exporter_poll_interval }}
DMARC_LOOKBACK_DAYS={{ dmarc_exporter_lookback_days }}
DMARC_WINDOW_DAYS={{ dmarc_exporter_window_days }}
