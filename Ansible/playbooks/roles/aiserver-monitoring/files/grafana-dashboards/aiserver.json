            "value": "1m"
          },
          {
            "selected": false,
            "text": "5m",
            "value": "5m"
          },
          {
            "selected": false,
            "text": "15m",
            "value": "15m"
          },
          {
            "selected": false,
            "text": "1h",
            "value": "1h"
          }
        ],
        "query": "1m,5m,15m,1h",
        "type": "custom"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": ".*"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{aiserver=~\".+\"}, aiserver)",
        "includeAll": true,
        "allValue": ".*",
        "label": "AI server",
        "multi": true,
        "name": "instance",
        "query": {
          "query": "label_values(up{aiserver=~\".+\"}, aiserver)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up{job=\"node-llamacpp\", aiserver=~\"$instance\"}, model)",
        "includeAll": true,
        "allValue": ".*",
        "label": "LLM model",
        "multi": true,
        "name": "llmModel",
        "query": {
          "query": "label_values(up{job=\"node-llamacpp\", aiserver=~\"$instance\"}, model)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": ".*"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(DCGM_FI_DEV_GPU_UTIL{aiserver=~\"$instance\"}, gpu)",
        "includeAll": true,
        "allValue": ".*",
        "label": "GPU",
        "multi": true,
        "name": "gpu",
        "query": {
          "query": "label_values(DCGM_FI_DEV_GPU_UTIL{aiserver=~\"$instance\"}, gpu)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "AI Server (FleetForge - llama.cpp / DCGM / ComfyUI)",
  "uid": "aiserver",
  "version": 5,
  "weekStart": "",
  "description": "Familles aiserver (Docker) et llamacpp (natif). Jobs node-llamacpp, aiserver-dcgm, aiserver-comfyui ; variable de machine = label `aiserver`."
}
