global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - '{{ hostvars[alertmanager_host]['ansible_host'] if alertmanager_host in hostvars else alertmanager_host }}:{{ alertmanager_port }}'

scrape_configs:
  # Auto-scrape. Les identifiants sont indispensables : /metrics est derrière la
  # même authentification basique que l'UI (web.yml), donc sans eux Prometheus
  # se scrape lui-même en 401 et fait sonner TargetDown en permanence.
  - job_name: 'prometheus'
    basic_auth:
      username: '{{ prometheus_user }}'
      password: '{{ prometheus_pass }}'
    static_configs:
      - targets: ['localhost:9090']

  # Métriques système (node_exporter). Déposées par `exporter-sys-install`.
  - job_name: 'exporter'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/exporter/*.json'
{% if prometheus_fast_scrape_instances | length > 0 %}
    relabel_configs:
      - source_labels: [instance]
        regex: '{{ prometheus_fast_scrape_instances | map('regex_escape') | join('|') }}'
        action: drop
{% endif %}
{% if prometheus_fast_scrape_instances | length > 0 %}

  # Même cible que `exporter`, à cadence rapide, pour les seules instances de `prometheus_fast_scrape_instances`.
  - job_name: 'exporter-fast'
    scrape_interval: {{ prometheus_fast_scrape_interval }}
    scrape_timeout: {{ prometheus_fast_scrape_timeout }}
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/exporter/*.json'
    relabel_configs:
      - source_labels: [instance]
        regex: '{{ prometheus_fast_scrape_instances | map('regex_escape') | join('|') }}'
        action: keep
      - target_label: job
        replacement: 'exporter'
{% endif %}

  - job_name: 'node-btc'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/node-btc/*.json'

  # Nœuds Theta Edge — cibles posées par theta-edge-monitoring (9601).
  - job_name: 'node-theta-edge'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/node-theta-edge/*.json'

  # Relais SMTP. `mailrelay-monitoring` dépose sa cible dans prometheus-configs/postfix ;
  # sans ce job le fichier resterait là sans jamais être lu.
  - job_name: 'postfix'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/postfix/*.json'

  # Serveur de messagerie complet : /metrics natif du contrôleur rspamd
  # (spam, actions, latence). Cibles posées par `mailserver-monitoring`.
  - job_name: 'rspamd'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/rspamd/*.json'

  # API indicateurs. Cible déposée par papangmetrics-api-install : HTTPS par le
  # frontal TLS de la machine (`__scheme__` dans le file_sd) quand il est actif.
  # /metrics exige le bearer METRICS_AUTH_TOKEN.
  - job_name: 'papangmetrics-api'
    metrics_path: /metrics
{% if prometheus_papangmetrics_token | length > 0 %}
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/papangmetrics.token
{% endif %}
    file_sd_configs:
      - files:
          - 'prometheus-configs/papangmetrics-api/*.json'

  # Worker ETL — porte brk_up, brk_height et etl_block_lag. C'est la source des
  # alertes BRK : l'API de BRK elle-même n'est pas scrapée (localhost only).
  # Derrière le frontal TLS : `__metrics_path__` = /etl/metrics dans le file_sd.
  - job_name: 'papangmetrics-etl'
    metrics_path: /metrics
{% if prometheus_papangmetrics_token | length > 0 %}
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/papangmetrics.token
{% endif %}
    file_sd_configs:
      - files:
          - 'prometheus-configs/papangmetrics-etl/*.json'

  # Rapports agrégés DMARC. Déposé par `dmarc-exporter-install`. C'est ce job
  # qui rend les rapports silencieux : sans lui, ils restent un mail quotidien
  # que personne ne lit.
  - job_name: 'dmarc'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/dmarc/*.json'

  # Sonde de service partagée (port 9110). Chaque rôle `<service>-monitoring`
  # dépose sa cible dans prometheus-configs/svcprobe ; sans ce job les fichiers
  # restaient là sans jamais être lus, et `service_up` n'existait sur aucun des
  # deux parcs — les groupes d'alertes `services` et `certificates` étaient
  # chargés, `health=ok`, et n'évaluaient rien.
  - job_name: 'svcprobe'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/svcprobe/*.json'
{% if prometheus_fast_scrape_instances | length > 0 %}
    relabel_configs:
      - source_labels: [instance]
        regex: '{{ prometheus_fast_scrape_instances | map('regex_escape') | join('|') }}'
        action: drop
{% endif %}
{% if prometheus_fast_scrape_instances | length > 0 %}

  # Même cible que `svcprobe`, à cadence rapide, pour les seules instances de `prometheus_fast_scrape_instances`.
  - job_name: 'svcprobe-fast'
    scrape_interval: {{ prometheus_fast_scrape_interval }}
    scrape_timeout: {{ prometheus_fast_scrape_timeout }}
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/svcprobe/*.json'
    relabel_configs:
      - source_labels: [instance]
        regex: '{{ prometheus_fast_scrape_instances | map('regex_escape') | join('|') }}'
        action: keep
      - target_label: job
        replacement: 'svcprobe'
{% endif %}

  # Alertmanager — /metrics natif. Cible déposée par `alertmanager-monitoring` dans
  # prometheus-configs/alertmanager/ ; sans ce job le fichier restait là sans jamais être lu, et ni
  # `alertmanager_notifications_failed_total` ni `up{job="alertmanager"}` n'existaient : on ne pouvait
  # donc pas voir que plus AUCUN e-mail d'alerte ne partait (constat du 25/10/2026, 0 envoi en 24 h).
  - job_name: 'alertmanager'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/alertmanager/*.json'

  # FleetForge — l'application de gestion du parc, qui expose Prometheus
  # nativement sur son port applicatif. Cible déposée par
  # `fleetforge-monitoring` ; sans ce job le fichier resterait là sans
  # jamais être lu, et l'état dégradé propre à ce service
  # (`fleetforge_ansible_available` à 0 : répond mais ne peut rien
  # déployer) passerait inaperçu.
  - job_name: 'fleetforge'
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - 'prometheus-configs/fleetforge/*.json'

  # Pushgateway — métriques POUSSÉES par les jobs batch / serveurs IA. Cible
  # déposée par `pushgateway-monitoring`. `honor_labels: true` OBLIGATOIRE :
  # sans lui chaque série poussée perd son `job` (renommé `exported_job`) et
  # toute règle de fraîcheur (`push_time_seconds`) filtrée par job est muette.
  - job_name: 'pushgateway'
    metrics_path: /metrics
    honor_labels: true
    file_sd_configs:
      - files:
          - 'prometheus-configs/pushgateway/*.json'

  # Serveur d'IA conteneurisé (`aiserver-monitoring`) : ComfyUI via le nœud
  # ComfyUI-api-tools, sur le port HTTP de ComfyUI. Les cibles llama.cpp du
  # même rôle vont dans `node-llamacpp`.
  - job_name: 'aiserver-comfyui'
    metrics_path: /api-tools/v1/metrics
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: (comfyui_.*|comfy_.*|python_gc_.*|python_info|process_.*)
        action: keep
    file_sd_configs:
      - files:
          - 'prometheus-configs/aiserver-comfyui/*.json'

  # GPU NVIDIA du serveur d'IA (exporter DCGM).
  - job_name: 'aiserver-dcgm'
    metrics_path: /metrics
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: (up|DCGM_FI_DEV_GPU_UTIL|DCGM_FI_DEV_MEM_COPY_UTIL|DCGM_FI_DEV_FB_USED|DCGM_FI_DEV_FB_FREE|DCGM_FI_DEV_FB_TOTAL|DCGM_FI_DEV_POWER_USAGE|DCGM_FI_DEV_GPU_TEMP|DCGM_FI_DEV_SM_CLOCK|DCGM_FI_DEV_GPU_CLOCK|DCGM_FI_DEV_ENC_UTIL|DCGM_FI_DEV_DEC_UTIL|DCGM_FI_DEV_PCIE_TX_BYTES|DCGM_FI_DEV_PCIE_RX_BYTES|DCGM_FI_DEV_NVLINK_TX_BYTES|DCGM_FI_DEV_NVLINK_RX_BYTES)
        action: keep
    file_sd_configs:
      - files:
          - 'prometheus-configs/aiserver-dcgm/*.json'

  # llama.cpp natif (`exporter-llamacpp-install`) et conteneurisé
  # (`aiserver-monitoring`) : repris de monitoring-install, absent ici jusqu'au
  # 16/10/2026 — une cible llama.cpp sur ce parc n'était jamais lue.
  - job_name: 'node-llamacpp'
    metrics_path: /metrics
    metric_relabel_configs:
      # llama-server exposes its native metrics under the "llamacpp:" namespace
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:kv_cache_usage_ratio"
        replacement: "kv_cache_usage_ratio"
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:requests_processing"
        replacement: "requests_processing"
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:requests_deferred"
        replacement: "requests_deferred"
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:prompt_tokens_total"
        replacement: "prompt_tokens_total"
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:tokens_predicted_total"
        replacement: "tokens_predicted_total"
      # Latence par jeton (tableau de bord aiserver).
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:prompt_seconds_total"
        replacement: "prompt_seconds_total"
      - source_labels: [__name__]
        target_label: __name__
        regex: "llamacpp:tokens_predicted_seconds_total"
        replacement: "tokens_predicted_seconds_total"
      # Keep only the useful renamed metrics plus the scrape health signal
      - source_labels: [__name__]
        target_label: __name__
        regex: (up|kv_cache_usage_ratio|requests_processing|requests_deferred|prompt_tokens_total|tokens_predicted_total|prompt_seconds_total|tokens_predicted_seconds_total)
        action: keep
    file_sd_configs:
      - files:
          - 'prometheus-configs/node-llamacpp/*.json'
