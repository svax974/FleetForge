{
  "service": "freellm",
  "up": {"kind": "http", "url": "{{ freellm_url }}/api/ping", "status": [200], "timeout": 10},
  "extra_checks": [
    {"name": "container", "kind": "docker", "container": "{{ freellm_container }}"},
    {"name": "models", "kind": "http", "url": "{{ freellm_url }}/v1/models", "status": [200], "timeout": 10}
  ],
  "metrics_command": [
    "{{ svcprobe_lib_dir }}/freellm-metrics.sh",
    "{{ freellm_url }}"
  ],
  "metrics_timeout": 15
}
