#!/usr/bin/env bash
# Sauvegarde logique de {{ pgbak_db }} vers {{ pgbak_dest_host }}
# ({{ pgbak_dest_user }}@{{ pgbak_dest_addr }}:{{ pgbak_dest_port }}, répertoire {{ pgbak_dest_dir }}).
#
# Le dump est STREAMÉ vers la destination : il ne touche jamais le disque
# local. C'est précisément ce qui manquait avant ce rôle — un dump local suivi
# d'une rotation qui ne s'exécute qu'après un succès a fini par remplir le
# disque de la source quand plusieurs dumps consécutifs ont échoué faute de
# place (incident tradekong du 2026-08-29).
#
# La destination n'offre pas de shell : la clé est liée à la passerelle
# `backup-gate` (rôle backup-setup), qui ne connaît que les verbes appelés ici
# (free-kb, last-success, put, commit, abort, list) et confine la source à son
# répertoire. `commit` contrôle le fichier, élague au nombre de générations
# fixé côté destination (horloge de la destination) puis enregistre le succès.
{% if pgbak_encrypt_recipient | length > 0 %}
#
# CHIFFRÉ : pg_dump | gzip | age -r <destinataire de l'opérateur>. Aucun repli en
# clair : `age` absent ou en échec, le dump échoue. Restauration : la clé privée
# de l'opérateur, sur l'entrée standard de postgres-restore.sh.
{% endif %}
#
# Généré par Ansible (rôle postgres-backup-install) — NE PAS ÉDITER À LA MAIN.
set -euo pipefail

BACKUP_NAME="{{ pgbak_name }}"
DB="{{ pgbak_db }}"
DB_USER="{{ pgbak_user }}"
CONTAINER="{{ pgbak_container }}"
INTERVAL_DAYS="{{ pgbak_interval_days }}"
MIN_FREE_GB="{{ pgbak_min_free_gb }}"
METRIC_FILE="{{ node_exporter_textfile_dir }}/backup_{{ pgbak_name }}.prom"
LOCK="/tmp/postgres-backup-{{ pgbak_name }}.lock"
{% if pgbak_encrypt_recipient | length > 0 %}
RECIPIENT="{{ pgbak_encrypt_recipient }}"
SUFFIX=".sql.gz.age"
{% else %}
SUFFIX=".sql.gz"
{% endif %}

SSH_KEY="{{ pgbak_ssh_key_path }}"
DEST="{{ pgbak_dest_user }}@{{ pgbak_dest_addr }}"
DEST_PORT="{{ pgbak_dest_port }}"
SSH_OPTS=(-p "${DEST_PORT}" -i "${SSH_KEY}" -o IdentitiesOnly=yes -o BatchMode=yes \
          -o ServerAliveInterval=60 -o ServerAliveCountMax=10)

log() { echo "$(date -Iseconds) [${BACKUP_NAME}] $*"; }

# Un appel = un verbe de la passerelle (commande forcée de la clé). Entrée
# standard fermée (`-n`), sauf pour `put`, qui reçoit le dump.
gate() { ssh -n "${SSH_OPTS[@]}" "${DEST}" "$@"; }
gate_put() { ssh "${SSH_OPTS[@]}" "${DEST}" put "$1"; }

write_metrics() {
  local status="$1" duration="$2" size="$3" ts="$4"
  local tmp="${METRIC_FILE}.$$"
  cat > "${tmp}" <<EOF
# HELP backup_last_status Résultat de la dernière exécution (1 = succès, 0 = échec).
# TYPE backup_last_status gauge
backup_last_status{backup="${BACKUP_NAME}"} ${status}
# HELP backup_last_success_timestamp_seconds Date de la dernière sauvegarde réussie.
# TYPE backup_last_success_timestamp_seconds gauge
backup_last_success_timestamp_seconds{backup="${BACKUP_NAME}"} ${ts}
# HELP backup_last_duration_seconds Durée de la dernière exécution.
# TYPE backup_last_duration_seconds gauge
backup_last_duration_seconds{backup="${BACKUP_NAME}"} ${duration}
# HELP backup_last_size_bytes Taille du dernier dump.
# TYPE backup_last_size_bytes gauge
backup_last_size_bytes{backup="${BACKUP_NAME}"} ${size}
EOF
  mv "${tmp}" "${METRIC_FILE}"
}

last_success_ts() {
  local ts
  ts="$(gate last-success 2>/dev/null)" || ts=0
  case "${ts}" in ''|*[!0-9]*) ts=0 ;; esac
  echo "${ts}"
}

fail() {
  log "[ERROR] $*"
  write_metrics 0 "$(( $(date +%s) - START ))" 0 "$(last_success_ts)"
  exit 1
}

# Un dump qui chevauche le suivant se disputerait l'espace disque de la
# destination et corromprait la rotation.
exec 9>"${LOCK}"
if ! flock -n 9; then
  log "Déjà en cours (verrou ${LOCK}) — abandon."
  exit 0
fi

START=$(date +%s)
{% if pgbak_encrypt_recipient | length > 0 %}

command -v age >/dev/null 2>&1 || fail "age introuvable : chiffrement exigé, aucun dump en clair."
{% endif %}

# ── Auto-limitation ────────────────────────────────────────────────────────
# En HEURES, avec 2 h de marge : le succès d'hier est enregistré quelques minutes
# APRÈS le départ du cron, si bien qu'aujourd'hui, à la même minute, il n'a pas
# encore 24 h — un calcul en jours entiers sautait une sauvegarde sur deux.
LAST_TS="$(last_success_ts)"
if [ "${LAST_TS}" != "0" ] && [ "${INTERVAL_DAYS}" -gt 0 ]; then
  AGE_H=$(( (START - LAST_TS) / 3600 ))
  if [ "${AGE_H}" -lt $(( INTERVAL_DAYS * 24 - 2 )) ]; then
    log "Ignoré : dernière sauvegarde vieille de ${AGE_H} h (< $(( INTERVAL_DAYS * 24 - 2 )) h)."
    exit 0
  fi
fi

# ── Contrôle de place (et de joignabilité) ─────────────────────────────────
FREE_KB="$(gate free-kb)" || fail "Destination injoignable ou passerelle en refus."
case "${FREE_KB}" in ''|*[!0-9]*) fail "Espace libre illisible sur la destination (« ${FREE_KB} »)." ;; esac
if [ "${FREE_KB}" -lt $(( MIN_FREE_GB * 1024 * 1024 )) ]; then
  fail "Place insuffisante : $(( FREE_KB / 1024 / 1024 )) Go libres, ${MIN_FREE_GB} Go requis."
fi

# ── Dump ───────────────────────────────────────────────────────────────────
STAMP="$(date +%Y-%m-%dT%H%M%S)"
OUT="${DB}-${STAMP}${SUFFIX}"

log "Dump de ${DB} → ${OUT}"

# `set -o pipefail` déjà actif : une erreur de pg_dump, de gzip{{ ', de age' if pgbak_encrypt_recipient | length > 0 else '' }} ou
# de l'écriture distante fait échouer le pipeline entier, pas seulement le dernier maillon.
{% if pgbak_encrypt_recipient | length > 0 %}
if ! docker exec "${CONTAINER}" pg_dump -U "${DB_USER}" -d "${DB}" | gzip | age -r "${RECIPIENT}" \
     | gate_put "${OUT}"; then
{% else %}
if ! docker exec "${CONTAINER}" pg_dump -U "${DB_USER}" -d "${DB}" | gzip \
     | gate_put "${OUT}"; then
{% endif %}
  gate abort "${OUT}" || true
  fail "Échec du dump."
fi

# La passerelle contrôle le `.tmp` ({{ 'fichier age complet' if pgbak_encrypt_recipient | length > 0 else 'flux gzip complet et non vide' }}) et ne le rend visible
# qu'ensuite ; puis elle élague (APRÈS le succès : purger d'abord laisserait un
# instant sans copie saine) et enregistre le succès avec SON horloge.
SIZE_BYTES="$(gate commit "${OUT}")" || { gate abort "${OUT}" || true; fail "Dump refusé par la destination."; }
case "${SIZE_BYTES}" in ''|*[!0-9]*) SIZE_BYTES=0 ;; esac

# Le dump doit encore être là après l'élagage : sinon, c'est un échec visible
# (BackupFailed), pas une sauvegarde comptée sans copie.
LISTING="$(gate list)" || fail "Liste des générations illisible après le dépôt."
printf '%s\n' "${LISTING}" | awk -F'\t' -v n="${OUT}" '$1 == n { found = 1 } END { exit !found }' \
  || fail "${OUT} absent de la destination après l'élagage."

END=$(date +%s)
write_metrics 1 "$(( END - START ))" "${SIZE_BYTES}" "${END}"
log "Terminé en $(( END - START )) s — $(( SIZE_BYTES / 1024 / 1024 )) Mo{{ ' (chiffré)' if pgbak_encrypt_recipient | length > 0 else '' }}."
