#!/usr/bin/env bash
# Restaure {{ pgbak_db }} depuis {{ pgbak_dest_host }} ({{ pgbak_dest_user }}@{{ pgbak_dest_addr }}:{{ pgbak_dest_port }},
# passerelle `backup-gate` : la clé de cette machine ne lit que SES sauvegardes).
# Généré par Ansible (rôle postgres-backup-install) — NE PAS ÉDITER À LA MAIN.
#
# Usage (un seul mode) :
#   {{ pgbak_dir }}/postgres-restore.sh --check                  # liste, ne lit ni ne restaure rien
#   {{ pgbak_dir }}/postgres-restore.sh --verify [--file <nom>]  # relit, déchiffre, décompresse ; n'écrit RIEN
#   {{ pgbak_dir }}/postgres-restore.sh --yes [--file <nom>]     # relit tout, charge à côté, puis échange
#
# Sauvegarde chiffrée (`.age`) : la clé PRIVÉE de l'opérateur arrive sur l'ENTRÉE STANDARD, depuis son poste,
# et n'est jamais écrite sur cette machine (gardée en mémoire, passée à age par un tube) :
#   age -d ~/.config/fleetforge/backup-key.age | ssh -p <port> {{ remote_username }}@<cette machine> \
#     '{{ pgbak_dir }}/postgres-restore.sh --verify'
#
# `--yes`, dans l'ordre — la base vivante n'est JAMAIS supprimée :
#   1. relecture COMPLÈTE (clé, intégrité age, gzip, ligne finale « -- PostgreSQL database dump complete ») ;
#   2. chargement dans une base À CÔTÉ (`<base>_restore`), ON_ERROR_STOP=1 : une erreur arrête tout, base vivante
#      intacte ;
#   3. les deux relectures doivent avoir la même empreinte (sha256 de ce que la destination a envoyé) ;
#   4. échange en UNE transaction : la base vivante devient `<base>_before_<horodatage>` (gardée : la supprimer à la
#      main une fois la restauration validée — elle occupe sa place sur le disque), la copie devient `<base>`.
# Arrête l'application AVANT `--yes` : ses connexions à la base sont coupées au moment de l'échange.
set -euo pipefail

DB="{{ pgbak_db }}"
DB_USER="{{ pgbak_user }}"
CONTAINER="{{ pgbak_container }}"

SSH_KEY="{{ pgbak_ssh_key_path }}"
DEST="{{ pgbak_dest_user }}@{{ pgbak_dest_addr }}"
DEST_PORT="{{ pgbak_dest_port }}"
SSH_OPTS=(-p "${DEST_PORT}" -i "${SSH_KEY}" -o IdentitiesOnly=yes -o BatchMode=yes \
          -o ServerAliveInterval=60 -o ServerAliveCountMax=10)
DUMP_END="-- PostgreSQL database dump complete"

MODE=""
DUMP_NAME=""

usage() { echo "Usage : $0 --check | --verify [--file <nom>] | --yes [--file <nom>]" >&2; exit 2; }
set_mode() {
  if [ -n "${MODE}" ] && [ "${MODE}" != "$1" ]; then
    echo "Options contradictoires : --${MODE} et --$1 (un seul mode)." >&2
    exit 2
  fi
  MODE="$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --yes)    set_mode yes ;;
    --check)  set_mode check ;;
    --verify) set_mode verify ;;
    --file)   [ $# -ge 2 ] || usage; shift; DUMP_NAME="$1" ;;
    *) echo "Option inconnue : $1" >&2; usage ;;
  esac
  shift
done
[ "${MODE}" = "check" ] && [ -n "${DUMP_NAME}" ] && { echo "--check liste tout : --file n'y a pas de sens." >&2; exit 2; }

log() { echo "$(date -Iseconds) $*"; }
die() { echo "ERREUR : $*" >&2; exit 1; }
sql() { docker exec "${CONTAINER}" psql -U "${DB_USER}" -d postgres -v ON_ERROR_STOP=1 -qtA -c "$1" </dev/null; }

# Entrée standard fermée (`-n`) : elle porte la clé de l'opérateur, aucun appel ne doit la consommer.
gate() { ssh -n "${SSH_OPTS[@]}" "${DEST}" "$@"; }

WORK=""
IDENTITY=""
cleanup() { IDENTITY=""; [ -n "${WORK}" ] && rm -rf "${WORK}"; return 0; }
trap cleanup EXIT

# Clé age de l'opérateur, lue sur l'entrée standard, gardée en mémoire (jamais dans un fichier ni dans les
# arguments d'un processus : `printf` est une commande interne du shell).
read_identity() {
  [ -t 0 ] && die "sauvegarde chiffrée : la clé age de l'opérateur est attendue sur l'entrée standard (voir l'en-tête)."
  IDENTITY="$(cat)"
  case "${IDENTITY}" in
    *AGE-SECRET-KEY-1*) ;;
    *) IDENTITY=""; die "entrée standard : aucune identité age (ligne AGE-SECRET-KEY-1…)." ;;
  esac
}
decrypt() { age -d -i <(printf '%s\n' "${IDENTITY}"); }

# Fichier tel que la destination l'envoie, recopié sur la sortie ; son empreinte (sha256) dans $2. Rien ne
# transite par le disque local (tube nommé dans un répertoire privé).
fetch() {
  local fifo="${WORK}/fifo.${RANDOM}" pid rc=0
  mkfifo -m 600 "${fifo}"
  sha256sum < "${fifo}" > "$2" &
  pid=$!
  gate get "$1" | tee "${fifo}" || rc=$?
  wait "${pid}" || rc=1
  rm -f "${fifo}"
  return "${rc}"
}

# Flux SQL décompressé de la sauvegarde $1, empreinte du fichier reçu dans $2.
stream() {
  case "$1" in
    *.age) fetch "$1" "$2" | decrypt | gunzip -c ;;
    *)     fetch "$1" "$2" | gunzip -c ;;
  esac
}

echo "Source des sauvegardes : {{ pgbak_dest_addr }}:{{ pgbak_dest_port }} ({{ pgbak_dest_dir }})"
echo "--- générations disponibles (plus récente en tête, heure de la destination) ---"
LISTING="$(gate list)" || die "destination injoignable ou passerelle en refus."
if [ -z "${LISTING}" ]; then
  echo "(aucune)"
else
  printf '%s\n' "${LISTING}" | while IFS=$'\t' read -r name bytes when; do
    case "${name}" in *.age) kind="chiffrée (age)" ;; *) kind="en clair" ;; esac
    printf '%s  %12s o  %s  %s\n' "${when}" "${bytes}" "${name}" "${kind}"
  done
fi
echo "------------------------------------------------------"

[ "${MODE}" = "check" ] && exit 0

if [ -z "${DUMP_NAME}" ]; then
  DUMP_NAME="$(printf '%s\n' "${LISTING}" | awk -F'\t' -v p="${DB}-" 'index($1, p) == 1 { print $1; exit }')"
  [ -n "${DUMP_NAME}" ] || die "aucune sauvegarde de ${DB} disponible."
else
  case "${DUMP_NAME}" in
    "${DB}-"*) ;;
    *) die "${DUMP_NAME} : nom attendu ${DB}-<horodatage>.sql.gz[.age] (sans chemin)." ;;
  esac
  printf '%s\n' "${LISTING}" | awk -F'\t' -v n="${DUMP_NAME}" '$1 == n { found = 1 } END { exit !found }' \
    || die "${DUMP_NAME} introuvable sur la destination."
fi

echo "Sauvegarde retenue : ${DUMP_NAME}"

if [ -z "${MODE}" ]; then
  cat >&2 <<EOF

ERREUR : confirmation requise.

--yes recharge la base '${DB}' depuis ${DUMP_NAME} (chargée à côté, puis
échangée : l'actuelle est gardée sous un autre nom). Les données postérieures à
cette sauvegarde ne seront plus dans '${DB}'.

Vérifie que l'application est arrêtée, puis relance avec --yes
(ou --verify pour seulement relire la sauvegarde).
EOF
  exit 1
fi

case "${DUMP_NAME}" in *.age) read_identity ;; esac
WORK="$(mktemp -d)"

# 1. Relecture COMPLÈTE avant toute écriture : mauvaise clé, fichier tronqué ou altéré (authentification age),
#    gzip corrompu, dump interrompu (ligne finale absente) — tout échoue ici, base intacte.
log "Relecture complète de ${DUMP_NAME}."
TAIL="$(stream "${DUMP_NAME}" "${WORK}/sum1" | tail -c 512)" \
  || die "relecture en échec (clé, intégrité ou compression) — base NON modifiée."
case "${TAIL}" in
  *"${DUMP_END}"*) ;;
  *) die "dump incomplet (ligne « ${DUMP_END} » absente) — base NON modifiée." ;;
esac
log "Sauvegarde lisible et complète (empreinte $(cut -c1-16 "${WORK}/sum1")…)."

[ "${MODE}" = "verify" ] && exit 0

RESTORE_DB="${DB:0:54}_restore"
OLD_DB="${DB:0:40}_before_$(date +%Y%m%d%H%M%S)"

ACTIVE="$(sql "SELECT count(*) FROM pg_stat_activity WHERE datname = '${DB}';")"
if [ "${ACTIVE:-0}" -gt 0 ]; then
  log "[WARN] ${ACTIVE} connexion(s) sur ${DB} — l'application tourne probablement encore ; coupées à l'échange."
fi

# 1b. Place pour la copie : elle est chargée À CÔTÉ de la base vivante, sur le même volume PGDATA du conteneur. Moins de
#     1,5 × pg_database_size(base) de libre (df dans le conteneur) : arrêt ICI, avant toute écriture — plutôt qu'un
#     disque plein en plein chargement (qui arrêterait aussi la base vivante). L'ancienne base, gardée après
#     l'échange, occupe encore sa place : la supprimer une fois validée.
DB_BYTES="$(sql "SELECT pg_database_size('${DB}');")" || die "taille de ${DB} illisible — base NON modifiée."
FREE_KB="$(docker exec "${CONTAINER}" sh -c 'df -Pk "${PGDATA:-/var/lib/postgresql/data}"' </dev/null | awk 'END { print $4 }')" \
  || die "espace libre du volume PGDATA illisible — base NON modifiée."
case "${DB_BYTES}" in ''|*[!0-9]*) die "taille de ${DB} illisible (« ${DB_BYTES} ») — base NON modifiée." ;; esac
case "${FREE_KB}" in ''|*[!0-9]*) die "espace libre du volume PGDATA illisible (« ${FREE_KB} ») — base NON modifiée." ;; esac
NEED_KB=$(( (DB_BYTES * 3 / 2 + 1023) / 1024 ))
if [ "${FREE_KB}" -le "${NEED_KB}" ]; then
  die "espace libre insuffisant sur le volume PGDATA de ${CONTAINER} : ${FREE_KB} Kio libres, plus de ${NEED_KB} Kio (1,5 × ${DB}) requis pour charger la copie à côté — base NON modifiée. Libérer de la place (anciennes bases *_before_*), puis relancer."
fi
log "Espace libre sur PGDATA : ${FREE_KB} Kio (copie estimée à ${NEED_KB} Kio au plus)."

# 2. Chargement À CÔTÉ : la base vivante n'est pas touchée tant que la copie n'est pas complète.
log "Chargement dans ${RESTORE_DB} (base vivante intacte)."
sql "DROP DATABASE IF EXISTS \"${RESTORE_DB}\";"
sql "CREATE DATABASE \"${RESTORE_DB}\" OWNER \"${DB_USER}\";"
if ! stream "${DUMP_NAME}" "${WORK}/sum2" \
     | docker exec -i "${CONTAINER}" psql -U "${DB_USER}" -d "${RESTORE_DB}" -v ON_ERROR_STOP=1 -q >/dev/null; then
  die "chargement en échec : ${DB} INTACTE ; copie partielle laissée dans ${RESTORE_DB} (à supprimer)."
fi

# 3. Ce qui vient d'être chargé est bien ce qui a été vérifié.
[ "$(cut -d' ' -f1 "${WORK}/sum1")" = "$(cut -d' ' -f1 "${WORK}/sum2")" ] \
  || die "les deux relectures diffèrent (fichier changé sur la destination ?) : ${DB} INTACTE, ${RESTORE_DB} à supprimer."

# 4. Échange en une transaction : jamais d'instant sans base, jamais de suppression.
log "Échange : ${DB} → ${OLD_DB}, ${RESTORE_DB} → ${DB}."
sql "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname IN ('${DB}', '${RESTORE_DB}') AND pid <> pg_backend_pid();" >/dev/null
sql "BEGIN; ALTER DATABASE \"${DB}\" RENAME TO \"${OLD_DB}\"; ALTER DATABASE \"${RESTORE_DB}\" RENAME TO \"${DB}\"; COMMIT;" \
  || die "échange refusé (connexion revenue ?) : ${DB} INTACTE, la copie restaurée est dans ${RESTORE_DB}."

log "Contrôle de cohérence."
sql "SELECT pg_size_pretty(pg_database_size('${DB}'));"

log "Restauration terminée. Ancienne base GARDÉE sous ${OLD_DB} : la supprimer à la main une fois l'application"
log "validée (DROP DATABASE \"${OLD_DB}\";). Relance l'application."
