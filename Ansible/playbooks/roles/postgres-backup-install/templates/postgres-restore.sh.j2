#!/usr/bin/env bash
# Restaure {{ pgbak_db }} depuis {{ pgbak_dest_host }} ({{ pgbak_dest_user }}@{{ pgbak_dest_addr }}:{{ pgbak_dest_port }},
# passerelle `backup-gate` : la clé de cette machine ne lit que SES sauvegardes).
# Généré par Ansible (rôle postgres-backup-install) — NE PAS ÉDITER À LA MAIN.
#
# Usage :
#   {{ pgbak_dir }}/postgres-restore.sh --check                  # liste, ne lit ni ne restaure rien
#   {{ pgbak_dir }}/postgres-restore.sh --verify [--file <nom>]  # relit, déchiffre, décompresse ; n'écrit RIEN
#   {{ pgbak_dir }}/postgres-restore.sh --yes [--file <nom>]     # vérifie ENTIÈREMENT, puis remplace la base
#
# Sauvegarde chiffrée (`.age`) : la clé PRIVÉE de l'opérateur arrive sur l'ENTRÉE STANDARD, depuis son poste,
# et n'est jamais écrite sur cette machine (gardée en mémoire, passée à age par un tube) :
#   age -d ~/fleetforge-backup.key.age | ssh -p <port> {{ remote_username }}@<cette machine> \
#     '{{ pgbak_dir }}/postgres-restore.sh --verify'
#
# ARRÊTE l'application AVANT `--yes` — elle écrit en continu dans la base, la
# laisser tourner mélange données restaurées et données fraîches sur une base à
# moitié reconstruite. `--yes` relit d'abord la sauvegarde EN ENTIER (clé,
# intégrité age, gzip) : la base vivante n'est supprimée qu'après ce contrôle.
set -euo pipefail

DB="{{ pgbak_db }}"
DB_USER="{{ pgbak_user }}"
CONTAINER="{{ pgbak_container }}"

SSH_KEY="{{ pgbak_ssh_key_path }}"
DEST="{{ pgbak_dest_user }}@{{ pgbak_dest_addr }}"
DEST_PORT="{{ pgbak_dest_port }}"
SSH_OPTS=(-p "${DEST_PORT}" -i "${SSH_KEY}" -o IdentitiesOnly=yes -o BatchMode=yes \
          -o ServerAliveInterval=60 -o ServerAliveCountMax=10)

MODE=list
DUMP_NAME=""

while [ $# -gt 0 ]; do
  case "$1" in
    --yes)    MODE=restore ;;
    --check)  MODE=check ;;
    --verify) MODE=verify ;;
    --file)   shift; DUMP_NAME="${1:-}" ;;
    *) echo "Option inconnue : $1" >&2; exit 2 ;;
  esac
  shift
done

log() { echo "$(date -Iseconds) $*"; }
die() { echo "ERREUR : $*" >&2; exit 1; }

# Entrée standard fermée (`-n`) : elle porte la clé de l'opérateur, aucun appel ne doit la consommer.
gate() { ssh -n "${SSH_OPTS[@]}" "${DEST}" "$@"; }

IDENTITY=""
# Clé age de l'opérateur, lue sur l'entrée standard, gardée en mémoire (jamais dans un fichier ni dans les
# arguments d'un processus : `printf` est une commande interne du shell).
read_identity() {
  [ -t 0 ] && die "sauvegarde chiffrée : la clé age de l'opérateur est attendue sur l'entrée standard (voir l'en-tête)."
  IDENTITY="$(cat)"
  case "${IDENTITY}" in
    *AGE-SECRET-KEY-1*) ;;
    *) IDENTITY=""; die "entrée standard : aucune identité age (ligne AGE-SECRET-KEY-1…)." ;;
  esac
}
decrypt() { age -d -i <(printf '%s\n' "${IDENTITY}"); }

# Flux décompressé de la sauvegarde : il ne transite jamais par le disque local.
stream() {
  case "$1" in
    *.age) gate get "$1" | decrypt | gunzip -c ;;
    *)     gate get "$1" | gunzip -c ;;
  esac
}

echo "Source des sauvegardes : {{ pgbak_dest_addr }}:{{ pgbak_dest_port }} ({{ pgbak_dest_dir }})"
echo "--- générations disponibles (plus récente en tête) ---"
LISTING="$(gate list)" || die "destination injoignable ou passerelle en refus."
if [ -z "${LISTING}" ]; then
  echo "(aucune)"
else
  printf '%s\n' "${LISTING}" | while IFS=$'\t' read -r name bytes when; do
    case "${name}" in *.age) kind="chiffrée (age)" ;; *) kind="en clair" ;; esac
    printf '%s  %12s o  %s  %s\n' "${when}" "${bytes}" "${name}" "${kind}"
  done
fi
echo "------------------------------------------------------"

[ "${MODE}" = "check" ] && exit 0

if [ -z "${DUMP_NAME}" ]; then
  DUMP_NAME="$(printf '%s\n' "${LISTING}" | awk -F'\t' -v p="${DB}-" 'index($1, p) == 1 { print $1; exit }')"
  [ -n "${DUMP_NAME}" ] || die "aucune sauvegarde de ${DB} disponible."
else
  case "${DUMP_NAME}" in
    "${DB}-"*) ;;
    *) die "${DUMP_NAME} : nom attendu ${DB}-<horodatage>.sql.gz[.age] (sans chemin)." ;;
  esac
  printf '%s\n' "${LISTING}" | awk -F'\t' -v n="${DUMP_NAME}" '$1 == n { found = 1 } END { exit !found }' \
    || die "${DUMP_NAME} introuvable sur la destination."
fi

echo "Sauvegarde retenue : ${DUMP_NAME}"

if [ "${MODE}" = "list" ]; then
  cat >&2 <<EOF

ERREUR : confirmation requise.

Cette opération SUPPRIME la base '${DB}' et la reconstruit depuis
${DUMP_NAME}. Toutes les données postérieures à cette sauvegarde sont perdues.

Vérifie que l'application est arrêtée, puis relance avec --yes
(ou --verify pour seulement relire la sauvegarde).
EOF
  exit 1
fi

case "${DUMP_NAME}" in *.age) read_identity ;; esac

# Relecture COMPLÈTE avant toute écriture : mauvaise clé, fichier tronqué ou altéré
# (authentification age), gzip corrompu — tout échoue ici, base intacte.
log "Relecture complète de ${DUMP_NAME}."
SQL_BYTES="$(stream "${DUMP_NAME}" | wc -c | tr -d ' ')" \
  || die "relecture en échec (clé, intégrité ou compression) — base NON modifiée."
log "Sauvegarde lisible : ${SQL_BYTES} octets de SQL."

[ "${MODE}" = "verify" ] && { IDENTITY=""; exit 0; }

ACTIVE="$(docker exec "${CONTAINER}" psql -U "${DB_USER}" -d "${DB}" -tAc \
  "SELECT count(*) FROM pg_stat_activity WHERE datname = '${DB}' AND application_name <> 'psql';" </dev/null)"
if [ "${ACTIVE}" -gt 0 ]; then
  log "[WARN] ${ACTIVE} connexion(s) active(s) sur ${DB} — l'application tourne probablement encore."
  log "[WARN] Elles seront coupées par le DROP DATABASE ... WITH (FORCE)."
fi

log "Suppression et recréation de ${DB}."
docker exec "${CONTAINER}" psql -U "${DB_USER}" -d postgres -v ON_ERROR_STOP=1 \
  -c "DROP DATABASE IF EXISTS \"${DB}\" WITH (FORCE);" </dev/null
docker exec "${CONTAINER}" psql -U "${DB_USER}" -d postgres -v ON_ERROR_STOP=1 \
  -c "CREATE DATABASE \"${DB}\" OWNER \"${DB_USER}\";" </dev/null

log "Chargement du dump."
# ON_ERROR_STOP=0 volontairement : un dump PostgreSQL rejoué contient toujours
# quelques ordres qui échouent sans conséquence (droits, extensions déjà
# présentes) ; les erreurs réelles sont dans le journal.
if ! stream "${DUMP_NAME}" | docker exec -i "${CONTAINER}" psql -U "${DB_USER}" -d "${DB}" -v ON_ERROR_STOP=0; then
  IDENTITY=""
  log "[ERROR] Le chargement a échoué. La base est dans un état intermédiaire."
  exit 1
fi
IDENTITY=""

log "Contrôle de cohérence."
docker exec "${CONTAINER}" psql -U "${DB_USER}" -d "${DB}" -c \
  "SELECT pg_size_pretty(pg_database_size(current_database())) AS taille;" </dev/null

log "Restauration terminée. Relance l'application."
