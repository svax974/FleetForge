{#- Comptes d'automatisation bornés de FleetForge (`ff_api_accounts`), généré
    par fleetforge-install. Empreintes argon2id seules : les clairs sont au
    vault du parc (`ff_api_password_<user>`). Format : crates/fleetforge-web,
    config.rs (`accounts_from_file`). -#}
{%- set ns = namespace(accounts=[]) -%}
{%- for account in ff_api_accounts -%}
{%- set entry = {
      'user': account.user,
      'password_hash': ff_api_account_hashes.results[loop.index0].stdout | trim,
      'parcs': account.parcs | default([parc_name]),
      'mode': account.mode | default('read')
    } -%}
{%- if account.deny_playbooks is defined -%}{%- set _ = entry.update({'deny_playbooks': account.deny_playbooks}) -%}{%- endif -%}
{%- if account.max_hosts is defined -%}{%- set _ = entry.update({'max_hosts': account.max_hosts | int}) -%}{%- endif -%}
{%- if account.accept_checks_from is defined -%}{%- set _ = entry.update({'accept_checks_from': account.accept_checks_from}) -%}{%- endif -%}
{%- if account.allow_playbooks is defined -%}{%- set _ = entry.update({'allow_playbooks': account.allow_playbooks}) -%}{%- endif -%}
{%- if account.allow_extra_vars is defined -%}{%- set _ = entry.update({'allow_extra_vars': account.allow_extra_vars}) -%}{%- endif -%}
{%- if account.allow_diff is defined -%}{%- set _ = entry.update({'allow_diff': account.allow_diff}) -%}{%- endif -%}
{%- set ns.accounts = ns.accounts + [entry] -%}
{%- endfor -%}
{{ ns.accounts | to_nice_json }}
