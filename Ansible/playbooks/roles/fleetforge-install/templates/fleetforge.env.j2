# Environnement du service FleetForge — généré par fleetforge-install.
# 0600 : il porte le mot de passe d'accès à l'interface.

FLEETFORGE_WEB_BIND={{ ff_bind }}
FLEETFORGE_WEB_PORT={{ ff_port }}
FLEETFORGE_WEB_STATIC={{ ff_dir }}/apps/gui/dist

# Authentification. Le serveur REFUSE de démarrer sur autre chose que la boucle
# locale sans ces deux valeurs : cette application pilote tout le parc, un port
# ouvert sans mot de passe y donne un accès administrateur.
#
# EMPREINTE argon2, jamais le mot de passe : le clair vit dans le vault du parc.
# Ce fichier ne permet donc pas de se connecter — ni ici, ni ailleurs. Il reste
# en 0600 pour autant, une empreinte étant attaquable hors ligne.
FLEETFORGE_WEB_USER={{ ff_web_user }}
FLEETFORGE_WEB_PASSWORD_HASH={{ ff_password_hash.stdout | trim }}

# Chemins livrés. Ils PRIMENT sur ce que la base a mémorisé : sur un serveur,
# c'est le déploiement qui sait où l'arbre a été déposé, pas un réglage saisi
# un jour dans l'interface.
FLEETFORGE_INVENTORIES_PATH={{ ff_ansible_dir }}/inventories
FLEETFORGE_PLAYBOOKS_PATH={{ ff_ansible_dir }}/playbooks
