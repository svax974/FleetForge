# Environnement du service FleetForge — généré par fleetforge-install.
# 0600 : il porte le mot de passe d'accès à l'interface.

FLEETFORGE_WEB_BIND={{ ff_bind }}
FLEETFORGE_WEB_PORT={{ ff_port }}
FLEETFORGE_WEB_STATIC={{ ff_dir }}/apps/gui/dist

# Authentification. Le serveur REFUSE de démarrer sur autre chose que la boucle
# locale sans ces deux valeurs : cette application pilote tout le parc, un port
# ouvert sans mot de passe y donne un accès administrateur.
#
# EMPREINTE argon2, jamais le mot de passe : le clair vit dans le vault du parc.
# Ce fichier ne permet donc pas de se connecter — ni ici, ni ailleurs. Il reste
# en 0600 pour autant, une empreinte étant attaquable hors ligne.
FLEETFORGE_WEB_USER={{ ff_web_user }}
FLEETFORGE_WEB_PASSWORD_HASH={{ ff_password_hash.stdout | trim }}
{% if ff_api_user | length > 0 %}

# Compte d'automatisation (AgentHub) : API d'automatisation seule. Empreinte
# argon2 elle aussi ; le clair (`ff_api_password`) est au vault du parc.
FLEETFORGE_API_USER={{ ff_api_user }}
FLEETFORGE_API_PASSWORD_HASH={{ ff_api_password_hash.stdout | trim }}
{% endif %}

# Arbre Ansible livré (inventories/ et playbooks/ en dessous). Il PRIME sur ce
# que la base a mémorisé : sur un serveur, c'est le déploiement qui sait où
# l'arbre a été déposé, pas un réglage saisi un jour dans l'interface.
FLEETFORGE_ANSIBLE_DIR={{ ff_ansible_dir }}
{% if ff_ro_diagnostics | bool %}

# Diagnostic lecture seule (`ssh_diagnose`) : clé dédiée au compte
# {{ ff_ro_user }}, qui n'ouvre que la passerelle ro-gate.
FLEETFORGE_RO_SSH_KEY={{ ff_ro_key }}
FLEETFORGE_RO_SSH_USER={{ ff_ro_user }}
FLEETFORGE_RO_KNOWN_HOSTS={{ ff_ro_known_hosts }}
{% endif %}
