NODE_ENV=production
API_PORT={{ pm_api_port }}
ETL_METRICS_PORT={{ pm_etl_metrics_port }}

# Indicators TimescaleDB (standalone box, reached over the DC-internal network -> no TLS)
METRICS_DB_HOST={{ pm_db_host }}
METRICS_DB_PORT={{ pm_db_port }}
METRICS_DB_USER={{ pm_db_user }}
METRICS_DB_PASSWORD={{ pm_db_pass }}
METRICS_DB_NAME={{ pm_db_name }}
METRICS_DB_SSL=false
METRICS_DB_SSL_CA_PATH=

# BRK local API
BRK_API_URL={{ pm_brk_url }}

# ETL
ETL_CRON={{ pm_etl_cron }}
ETL_REORG_WINDOW_BLOCKS={{ pm_etl_reorg_window }}
ETL_BACKFILL_CONCURRENCY={{ pm_etl_backfill_concurrency }}
ETL_INCREMENTAL_CONCURRENCY={{ pm_etl_incremental_concurrency }}

# Auth: internal service JWT (asymmetric RS256). Drop the public key at the path below.
JWT_PUBLIC_KEY_PATH={{ pm_dir }}/certs/service-jwt.pub

# Public throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Admin panel (PapangWorkspace indicatorApi console)
ADMIN_USERNAME={{ pm_admin_username }}
ADMIN_PASSWORD={{ pm_admin_password }}
ADMIN_JWT_SECRET={{ pm_admin_jwt_secret }}
ADMIN_JWT_EXPIRES_IN={{ pm_admin_jwt_expires_in }}

# Default credit quotas (new tenants/keys without an explicit quota)
DEFAULT_TENANT_CREDITS_QUOTA={{ pm_default_tenant_credits_quota }}
DEFAULT_APIKEY_CREDITS_QUOTA={{ pm_default_apikey_credits_quota }}
DEFAULT_PERIOD_TYPE={{ pm_default_period_type }}
