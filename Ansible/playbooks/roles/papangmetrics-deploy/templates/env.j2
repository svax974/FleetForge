# Généré par Ansible (papangmetrics-deploy) — NE PAS ÉDITER SUR L'HÔTE.
# Variables : PapangMetrics/.env.example et README « Sécurité HTTP ».
NODE_ENV=production
API_PORT={{ pm_api_port }}
ETL_METRICS_PORT={{ pm_etl_metrics_port }}
{% if pm_loopback_only | bool %}
# Derrière le frontal TLS nginx local (papangmetrics-tls-install) : boucle locale uniquement.
API_HOST=127.0.0.1
ETL_METRICS_HOST=127.0.0.1
{% else %}
API_HOST=
ETL_METRICS_HOST=
{% endif %}

# Indicators TimescaleDB (VPS distinct, joint par Internet : voir pm_db_ssl dans defaults/main.yml)
METRICS_DB_HOST={{ pm_db_host }}
METRICS_DB_PORT={{ pm_db_port }}
METRICS_DB_USER={{ pm_db_user }}
METRICS_DB_PASSWORD={{ pm_db_pass }}
METRICS_DB_NAME={{ pm_db_name }}
METRICS_DB_SSL={{ pm_db_ssl | bool | lower }}
METRICS_DB_SSL_CA_PATH={{ pm_db_ssl_ca_path }}
# Pool et timeouts par process (src/database/db-runtime-options.ts) ; METRICS_DB_ROLE déduit du point d'entrée.
METRICS_DB_POOL_MAX={{ pm_db_pool_max }}
METRICS_DB_POOL_IDLE_TIMEOUT_MS={{ pm_db_pool_idle_timeout_ms }}
METRICS_DB_CONNECTION_TIMEOUT_MS={{ pm_db_connection_timeout_ms }}
METRICS_DB_STATEMENT_TIMEOUT_MS={{ pm_db_statement_timeout_ms }}
METRICS_DB_ETL_STATEMENT_TIMEOUT_MS={{ pm_db_etl_statement_timeout_ms }}
METRICS_DB_MAINTENANCE_STATEMENT_TIMEOUT_MS={{ pm_db_maintenance_statement_timeout_ms }}

# BRK local API
BRK_API_URL={{ pm_brk_url }}

# ETL
ETL_CRON={{ pm_etl_cron }}
ETL_REORG_WINDOW_BLOCKS={{ pm_etl_reorg_window }}
ETL_BACKFILL_CONCURRENCY={{ pm_etl_backfill_concurrency }}
ETL_INCREMENTAL_CONCURRENCY={{ pm_etl_incremental_concurrency }}
ETL_BRK_HTTP_TIMEOUT_MS={{ pm_etl_brk_http_timeout_ms }}
ETL_STUCK_WARN_MS={{ pm_etl_stuck_warn_ms }}
{% for tf, slots in pm_etl_refetch_slots.items() %}
ETL_REFETCH_SLOTS_{{ tf | upper }}={{ slots }}
{% endfor %}
ETL_SYNC_STATE_FLUSH_EVERY={{ pm_etl_sync_state_flush_every }}
# Purge préparée des metric_job done/failed — opération destructive, désactivée.
METRIC_JOB_PURGE_ENABLED={{ pm_metric_job_purge_enabled | bool | lower }}
METRIC_JOB_PURGE_DAYS={{ pm_metric_job_purge_days }}
METRIC_JOB_PURGE_BATCH={{ pm_metric_job_purge_batch }}

# Évaluation / recalcul des formules
FORMULA_EVAL_MAX_CONCURRENT={{ pm_formula_eval_max_concurrent }}
FORMULA_INPUT_LOAD_CONCURRENCY={{ pm_formula_input_load_concurrency }}
FORMULA_INPUT_CACHE_MAX_MB={{ pm_formula_input_cache_max_mb }}
FORMULA_OUTPUT_CACHE_MAX_ENTRIES={{ pm_formula_output_cache_max_entries }}
FORMULA_OUTPUT_CACHE_MAX_MB={{ pm_formula_output_cache_max_mb }}
FORMULA_WRITE_RELATIVE_EPSILON={{ pm_formula_write_relative_epsilon }}
METRIC_ID_CACHE_TTL_MS={{ pm_metric_id_cache_ttl_ms }}

# Auth : JWT de service RS256, une clé publique par environnement PapangWorkspace (kid = nom de fichier).
JWT_PUBLIC_KEY_PATHS={{ pm_service_jwt_key_paths | join(',') }}
SERVICE_JWT_ISSUER={{ pm_service_jwt_issuer }}
SERVICE_JWT_AUDIENCE={{ pm_service_jwt_audience }}
SERVICE_JWT_MAX_AGE={{ pm_service_jwt_max_age }}

# Limitation de débit (fenêtre THROTTLE_TTL s)
THROTTLE_TTL={{ pm_throttle_ttl }}
THROTTLE_LIMIT={{ pm_throttle_limit }}
THROTTLE_IP_LIMIT={{ pm_throttle_ip_limit }}
THROTTLE_SERVICE_LIMIT={{ pm_throttle_service_limit }}
THROTTLE_ADMIN_AUTH_LIMIT={{ pm_throttle_admin_auth_limit }}
THROTTLE_ADMIN_AUTH_TTL={{ pm_throttle_admin_auth_ttl }}
API_KEY_CACHE_TTL_MS={{ pm_api_key_cache_ttl_ms }}

# HTTP
CORS_ORIGINS={{ pm_cors_origins | join(',') }}
SWAGGER_ENABLED={{ pm_swagger_enabled | bool | lower }}
TRUST_PROXY={{ pm_trust_proxy }}
HTTP_BODY_LIMIT={{ pm_http_body_limit }}
METRICS_AUTH_TOKEN={{ pm_metrics_auth_token }}

# Admin panel (console « API access » de PapangWorkspace). Pas d'ADMIN_PASSWORD en clair.
# Hash entre apostrophes : il contient des `$` (scrypt$N$r$p$…) que le parseur
# d'EnvironmentFile de systemd développerait sinon comme des variables.
ADMIN_USERNAME={{ pm_admin_username }}
ADMIN_PASSWORD_HASH='{{ pm_admin_password_hash }}'
ADMIN_JWT_SECRET={{ pm_admin_jwt_secret }}
ADMIN_JWT_EXPIRES_IN={{ pm_admin_jwt_expires_in }}

# Default credit quotas (new tenants/keys without an explicit quota)
DEFAULT_TENANT_CREDITS_QUOTA={{ pm_default_tenant_credits_quota }}
DEFAULT_APIKEY_CREDITS_QUOTA={{ pm_default_apikey_credits_quota }}
DEFAULT_PERIOD_TYPE={{ pm_default_period_type }}
