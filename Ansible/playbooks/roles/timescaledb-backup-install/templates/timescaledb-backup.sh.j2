#!/usr/bin/env bash
# Sauvegarde logique de la base d'indicateurs vers {{ tsdb_backup_dest_host }}
{% if tsdb_backup_is_local | bool %}
# ({{ tsdb_backup_dest_dir }} — DESTINATION LOCALE, cette machine).
#
# La destination désigne aujourd'hui la machine qui héberge la base : le dump
# reste donc sur place. Ce n'est PAS une sauvegarde au sens strict — elle ne
# protège que d'une erreur logique (table effacée, migration ratée), pas de la
# perte du disque ni de l'indisponibilité de l'hôte. Changer `ansible_host` de
# `{{ tsdb_backup_dest_host }}` dans l'inventaire puis jouer
# `retarget-backups.yml` bascule automatiquement ce script en mode distant.
{% else %}
# ({{ tsdb_backup_dest_user }}@{{ tsdb_backup_dest_addr }}:{{ tsdb_backup_dest_dir }}).
#
# Le dump est STREAMÉ vers la destination : il ne touche jamais le disque local,
# ce qui évite d'exiger 22 Go libres sur la machine de base pour la sauvegarder.
{% endif %}
# Généré par Ansible (rôle timescaledb-backup-install) — NE PAS ÉDITER À LA MAIN.
set -euo pipefail

BACKUP_NAME="papangmetrics-timescale"
DB="{{ tsdb_db }}"
DB_USER="{{ tsdb_user }}"
CONTAINER="{{ tsdb_container }}"
DEST_DIR="{{ tsdb_backup_dest_dir }}"
INTERVAL_DAYS="{{ tsdb_backup_interval_days }}"
KEEP="{{ tsdb_backup_keep }}"
MIN_FREE_GB="{{ tsdb_backup_min_free_gb }}"
METRIC_FILE="{{ node_exporter_textfile_dir }}/backup_timescale.prom"
LOCK="/tmp/timescaledb-backup.lock"

log() { echo "$(date -Iseconds) $*"; }

{% if tsdb_backup_is_local | bool %}
dest_sh() { bash -c "$1"; }
{% else %}
SSH_KEY="{{ tsdb_backup_ssh_key_path }}"
DEST="{{ tsdb_backup_dest_user }}@{{ tsdb_backup_dest_addr }}"
DEST_PORT="{{ tsdb_backup_dest_port }}"
dest_sh() {
  ssh -p "${DEST_PORT}" -i "${SSH_KEY}" -o BatchMode=yes \
      -o ServerAliveInterval=60 -o ServerAliveCountMax=10 "${DEST}" "$1"
}
{% endif %}

write_metrics() {
  local status="$1" duration="$2" size="$3" ts="$4"
  local tmp="${METRIC_FILE}.$$"
  cat > "${tmp}" <<EOF
# HELP backup_last_status Résultat de la dernière exécution (1 = succès, 0 = échec).
# TYPE backup_last_status gauge
backup_last_status{backup="${BACKUP_NAME}"} ${status}
# HELP backup_last_success_timestamp_seconds Date de la dernière sauvegarde réussie.
# TYPE backup_last_success_timestamp_seconds gauge
backup_last_success_timestamp_seconds{backup="${BACKUP_NAME}"} ${ts}
# HELP backup_last_duration_seconds Durée de la dernière exécution.
# TYPE backup_last_duration_seconds gauge
backup_last_duration_seconds{backup="${BACKUP_NAME}"} ${duration}
# HELP backup_last_size_bytes Taille du dernier dump.
# TYPE backup_last_size_bytes gauge
backup_last_size_bytes{backup="${BACKUP_NAME}"} ${size}
EOF
  mv "${tmp}" "${METRIC_FILE}"
}

last_success_ts() { dest_sh "cat '${DEST_DIR}/last-success' 2>/dev/null" || echo 0; }

fail() {
  log "[ERROR] $*"
  write_metrics 0 "$(( $(date +%s) - START ))" 0 "$(last_success_ts)"
  exit 1
}

# Un dump complet dure plusieurs heures sur cette base : sans verrou, deux
# exécutions se recouvriraient et se disputeraient l'espace disque de la
# destination.
exec 9>"${LOCK}"
if ! flock -n 9; then
  log "Déjà en cours (verrou ${LOCK}) — abandon."
  exit 0
fi

START=$(date +%s)

# ── Auto-limitation ────────────────────────────────────────────────────────
LAST_TS="$(last_success_ts)"
LAST_TS="${LAST_TS:-0}"
if [ "${LAST_TS}" != "0" ]; then
  AGE_DAYS=$(( (START - LAST_TS) / 86400 ))
  if [ "${AGE_DAYS}" -lt "${INTERVAL_DAYS}" ]; then
    log "Ignoré : dernière sauvegarde vieille de ${AGE_DAYS} j (< ${INTERVAL_DAYS})."
    exit 0
  fi
fi

dest_sh "mkdir -p '${DEST_DIR}'" || fail "Destination injoignable."

# ── Contrôle de place ──────────────────────────────────────────────────────
# Un `pg_dump | gzip` qui remplit le disque produit une archive tronquée que
# rien ne distingue d'une archive complète tant qu'on n'essaie pas de la
# restaurer. Le contrôle a lieu avant, et le renommage final après.
FREE_KB="$(dest_sh "df -Pk '${DEST_DIR}' | awk 'NR==2 {print \$4}'")" \
  || fail "Impossible de mesurer l'espace libre sur la destination."
if [ "${FREE_KB}" -lt $(( MIN_FREE_GB * 1024 * 1024 )) ]; then
  fail "Place insuffisante : $(( FREE_KB / 1024 / 1024 )) Go libres, ${MIN_FREE_GB} Go requis."
fi

# ── Dump ───────────────────────────────────────────────────────────────────
STAMP="$(date +%Y-%m-%dT%H%M%S)"
OUT="${DEST_DIR}/${DB}-${STAMP}.sql.gz"
TMP="${OUT}.tmp"

log "Dump de ${DB} → ${OUT}"

# `set -o pipefail` est déjà actif : une erreur de pg_dump ou de gzip fait
# échouer le pipeline entier. Sans cela, seul le code de sortie du DERNIER
# maillon compterait et un dump interrompu passerait pour un succès.
{% if tsdb_backup_is_local | bool %}
if ! docker exec "${CONTAINER}" pg_dump -U "${DB_USER}" -d "${DB}" | gzip > "${TMP}"; then
  rm -f "${TMP}"
  fail "Échec du dump."
fi
{% else %}
if ! docker exec "${CONTAINER}" pg_dump -U "${DB_USER}" -d "${DB}" | gzip \
     | ssh -p "${DEST_PORT}" -i "${SSH_KEY}" -o BatchMode=yes \
           -o ServerAliveInterval=60 -o ServerAliveCountMax=10 \
           "${DEST}" "cat > '${TMP}'"; then
  dest_sh "rm -f '${TMP}'" || true
  fail "Échec du dump."
fi
{% endif %}

# Le renommage n'a lieu qu'après un dump complet : un `.tmp` traînant est
# visiblement un échec, alors qu'un `.sql.gz` tronqué se ferait passer pour une
# sauvegarde valide auprès de la rétention comme de la restauration.
dest_sh "mv '${TMP}' '${OUT}'" || fail "Échec du renommage final."

# ── Rétention ──────────────────────────────────────────────────────────────
# Purge APRÈS le succès du nouveau dump : purger d'abord ferait passer par un
# instant où il n'existe qu'une seule copie — ou aucune, si le dump échoue.
# Le tri porte sur le nom, dont l'horodatage est ISO donc trié lexicalement.
dest_sh "ls -1 '${DEST_DIR}'/${DB}-*.sql.gz 2>/dev/null | sort -r | tail -n +$(( KEEP + 1 )) | xargs -r rm -f" \
  || log "[WARN] Purge des anciennes générations en échec."

END=$(date +%s)
dest_sh "echo ${END} > '${DEST_DIR}/last-success'"
SIZE_BYTES="$(dest_sh "stat -c %s '${OUT}'" || echo 0)"
write_metrics 1 "$(( END - START ))" "${SIZE_BYTES}" "${END}"
log "Terminé en $(( END - START )) s — $(( SIZE_BYTES / 1024 / 1024 )) Mo."
