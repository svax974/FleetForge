# Rotation des journaux de BRK — géré par Ansible, ne pas éditer.
#
# BRK écrit un fichier par jour ({{ brk_dir }}/logs/AAAA-MM-JJ[_info|_warn|_error].txt)
# et ne les purge jamais. Sans cette rotation, le répertoire croît sans limite :
# 4,3 Go constatés le 06/08/2026, dont 492 Mo pour le seul fichier d'erreurs du
# jour — 3,4 millions de fois la même panique.
{{ brk_dir }}/logs/*.txt {
    daily
    rotate {{ brk_logrotate_rotate }}
    maxsize {{ brk_logrotate_maxsize }}
    missingok
    notifempty
    compress
    delaycompress
    # BRK garde ses descripteurs ouverts sur la journée en cours : on copie puis
    # on tronque plutôt que de renommer, sinon il continuerait d'écrire dans un
    # fichier devenu invisible.
    copytruncate
    su {{ brk_user }} {{ brk_user }}
}
