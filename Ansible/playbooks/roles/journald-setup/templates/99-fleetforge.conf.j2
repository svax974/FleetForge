# Géré par Ansible — rôle `journald-setup`. Toute modification locale sera
# écrasée au prochain passage.
#
# Drop-in plutôt que /etc/systemd/journald.conf : le fichier principal
# appartient au paquet systemd et une mise à jour de la distribution le
# remplace, emportant silencieusement le plafond avec lui.
[Journal]
SystemMaxUse={{ journald_system_max_use }}
SystemKeepFree={{ journald_system_keep_free }}
SystemMaxFileSize={{ journald_max_file_size }}
MaxRetentionSec={{ journald_max_retention }}
RuntimeMaxUse={{ journald_runtime_max_use }}
