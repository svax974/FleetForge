#!/usr/bin/env bash
# Sauvegarde cohérente de l'instance web3c-sync « {{ sync_instance }} » vers
# {{ sync_backup_dest_user }}@{{ sync_backup_dest_addr }}:{{ sync_backup_dest_dir }}.
#
# Contenu d'une archive sync-{{ sync_instance }}-<horodatage>.tar.gz :
#   sync.db   instantané `VACUUM INTO` (cohérent, compacté, sans pages libres)
#   blobs/    copie du répertoire des blobs, prise APRÈS l'instantané
# Les blobs sont copiés après la base : un blob écrit entre-temps est un orphelin
# inoffensif, alors qu'un blob supprimé entre-temps laisserait la base en
# référencer un absent (rare : suppression de blob ou purge de groupe pendant la
# fenêtre de copie — rejouer la sauvegarde).
#
# RESTAURATION (sur la machine du serveur, conteneur arrêté) :
#   docker stop sync-{{ sync_instance }}
#   mkdir /tmp/restore && ssh -p {{ sync_backup_dest_port }} {{ sync_backup_dest_user }}@{{ sync_backup_dest_addr }} \
#     "cat {{ sync_backup_dest_dir }}/<archive>.tar.gz" | tar -xz -C /tmp/restore
#   rm -f {{ sync_backup_data_dir }}/sync.db{,-wal,-shm}; rm -rf {{ sync_backup_data_dir }}/blobs
#   cp /tmp/restore/sync.db {{ sync_backup_data_dir }}/ ; cp -a /tmp/restore/blobs {{ sync_backup_data_dir }}/
#   chown -R {{ sync_backup_uid }}:{{ sync_backup_gid }} {{ sync_backup_data_dir }} && docker start sync-{{ sync_instance }}
#
# Généré par Ansible (rôle sync-backup-install) — NE PAS ÉDITER À LA MAIN.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

BACKUP_NAME="{{ sync_backup_name }}"
DATA_DIR="{{ sync_backup_data_dir }}"
DB="${DATA_DIR}/sync.db"
UID_IMG="{{ sync_backup_uid }}"
GID_IMG="{{ sync_backup_gid }}"
DEST_DIR="{{ sync_backup_dest_dir }}"
KEEP="{{ sync_backup_keep }}"
MIN_FREE_GB="{{ sync_backup_min_free_gb }}"
METRIC_FILE="{{ node_exporter_textfile_dir }}/backup_{{ sync_backup_name }}.prom"
LOCK="/run/lock/sync-backup-{{ sync_instance }}.lock"

SSH_KEY="{{ sync_backup_ssh_key }}"
KNOWN_HOSTS="{{ sync_backup_known_hosts }}"
DEST="{{ sync_backup_dest_user }}@{{ sync_backup_dest_addr }}"
DEST_PORT="{{ sync_backup_dest_port }}"
SSH_OPTS=(-p "${DEST_PORT}" -i "${SSH_KEY}" -o BatchMode=yes -o UserKnownHostsFile="${KNOWN_HOSTS}" \
          -o ServerAliveInterval=60 -o ServerAliveCountMax=10)

log() { echo "$(date -Iseconds) $*"; }
dest_sh() { ssh "${SSH_OPTS[@]}" "${DEST}" "$1"; }

write_metrics() {
  local status="$1" duration="$2" size="$3" ts="$4"
  local tmp="${METRIC_FILE}.$$"
  cat > "${tmp}" <<EOT
# HELP backup_last_status Résultat de la dernière exécution (1 = succès, 0 = échec).
# TYPE backup_last_status gauge
backup_last_status{backup="${BACKUP_NAME}"} ${status}
# HELP backup_last_success_timestamp_seconds Date de la dernière sauvegarde réussie.
# TYPE backup_last_success_timestamp_seconds gauge
backup_last_success_timestamp_seconds{backup="${BACKUP_NAME}"} ${ts}
# HELP backup_last_duration_seconds Durée de la dernière exécution.
# TYPE backup_last_duration_seconds gauge
backup_last_duration_seconds{backup="${BACKUP_NAME}"} ${duration}
# HELP backup_last_size_bytes Taille de la dernière archive.
# TYPE backup_last_size_bytes gauge
backup_last_size_bytes{backup="${BACKUP_NAME}"} ${size}
EOT
  chmod 0644 "${tmp}"
  mv "${tmp}" "${METRIC_FILE}"
}

last_success_ts() { dest_sh "cat '${DEST_DIR}/last-success' 2>/dev/null" || echo 0; }

START=$(date +%s)
STAGE=""
cleanup() { [ -n "${STAGE}" ] && rm -rf "${STAGE}"; return 0; }
trap cleanup EXIT

fail() {
  log "[ERROR] $*"
  write_metrics 0 "$(( $(date +%s) - START ))" 0 "$(last_success_ts || echo 0)"
  exit 1
}

# Deux exécutions simultanées se disputeraient le répertoire de staging.
exec 9>"${LOCK}"
if ! flock -n 9; then
  log "Déjà en cours (verrou ${LOCK}) — abandon."
  exit 0
fi

# Pas encore de base (service jamais démarré, ou purgé) : rien à sauvegarder, et
# surtout pas un échec — il ferait sonner BackupFailed avant le premier déploiement.
if [ ! -f "${DB}" ]; then
  log "Aucune base (${DB}) — rien à sauvegarder."
  exit 0
fi

dest_sh "mkdir -p '${DEST_DIR}'" || fail "Destination injoignable."

FREE_KB="$(dest_sh "df -Pk '${DEST_DIR}' | awk 'NR==2 {print \$4}'")" \
  || fail "Impossible de mesurer l'espace libre sur la destination."
if [ "${FREE_KB}" -lt $(( MIN_FREE_GB * 1024 * 1024 )) ]; then
  fail "Place insuffisante : $(( FREE_KB / 1024 / 1024 )) Go libres, ${MIN_FREE_GB} Go requis."
fi

# ── Instantané cohérent ─────────────────────────────────────────────────────
# Sous l'uid de l'image, en lecture seule (voir l'en-tête de defaults/main.yml du
# rôle) ; le répertoire de staging lui appartient le temps de l'instantané.
STAGE="$(mktemp -d /var/tmp/sync-backup-{{ sync_instance }}.XXXXXX)"
chown "${UID_IMG}:${GID_IMG}" "${STAGE}"
chmod 0700 "${STAGE}"

log "Instantané de ${DB}"
setpriv --reuid="${UID_IMG}" --regid="${GID_IMG}" --clear-groups \
  sqlite3 -readonly -cmd ".timeout 30000" "${DB}" "VACUUM INTO '${STAGE}/sync.db'" \
  || fail "VACUUM INTO a échoué."

CHECK="$(sqlite3 -readonly "${STAGE}/sync.db" "PRAGMA integrity_check" 2>&1 || true)"
[ "${CHECK}" = "ok" ] || fail "Instantané corrompu (integrity_check : ${CHECK})."

# ── Archive streamée vers la destination ────────────────────────────────────
STAMP="$(date +%Y-%m-%dT%H%M%S)"
OUT="${DEST_DIR}/sync-{{ sync_instance }}-${STAMP}.tar.gz"
TMP="${OUT}.tmp"

TAR_ARGS=(-C "${STAGE}" sync.db)
[ -d "${DATA_DIR}/blobs" ] && TAR_ARGS+=(-C "${DATA_DIR}" blobs)

log "Archive → ${OUT}"
if ! tar -czf - "${TAR_ARGS[@]}" | ssh "${SSH_OPTS[@]}" "${DEST}" "cat > '${TMP}'"; then
  dest_sh "rm -f '${TMP}'" || true
  fail "Échec du transfert."
fi

# Archive vérifiée AVANT de la rendre visible : un `.tmp` traînant est
# visiblement un échec, un `.tar.gz` tronqué se ferait passer pour valide.
dest_sh "gzip -t '${TMP}' && mv '${TMP}' '${OUT}'" \
  || { dest_sh "rm -f '${TMP}'" || true; fail "Archive illisible côté destination."; }

# Rétention APRÈS le succès : purger d'abord laisserait un instant sans copie
# saine si le transfert échouait ensuite.
dest_sh "ls -1 '${DEST_DIR}'/sync-{{ sync_instance }}-*.tar.gz 2>/dev/null | sort -r | tail -n +$(( KEEP + 1 )) | xargs -r rm -f" \
  || log "[WARN] Purge des anciennes générations en échec."

END=$(date +%s)
dest_sh "echo ${END} > '${DEST_DIR}/last-success'"
SIZE_BYTES="$(dest_sh "stat -c %s '${OUT}'" || echo 0)"
write_metrics 1 "$(( END - START ))" "${SIZE_BYTES}" "${END}"
log "Terminé en $(( END - START )) s — $(( SIZE_BYTES / 1024 )) Kio."
