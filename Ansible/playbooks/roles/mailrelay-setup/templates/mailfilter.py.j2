#!/usr/bin/env python3
# Postfix after-queue content filter — per-domain Subject prefix + Reply-To injection.
# Reads raw message from stdin, modifies headers based on From domain config,
# re-injects to 127.0.0.1:10026 (OpenDKIM milter signs the modified message there).
# Generated by Ansible — DO NOT EDIT MANUALLY

import sys
import re
import json
import email
import email.policy
import email.utils
import smtplib

CONFIG_FILE = '/etc/postfix/mailserver-domains.json'
REINJECT_HOST = '127.0.0.1'
REINJECT_PORT = 10026
EX_DATAERR = 65   # permanent failure: pipe(8) bounces the message
EX_TEMPFAIL = 75


def parse_args(argv):
    sender = ''
    recipients = []
    i = 1
    while i < len(argv):
        if argv[i] == '-f' and i + 1 < len(argv):
            sender = argv[i + 1]
            i += 2
        elif argv[i] == '--':
            recipients = argv[i + 1:]
            break
        else:
            i += 1
    return sender, recipients


def parse_binding_args(argv):
    """`--sasl-username=<login>` and `--bindings=<file>`, given by master.cf ONLY when mailrelay_sender_bindings is set.
    (login, file): file is None without the option, login is '' for a message that did not come from an authenticated client."""
    login, path = '', None
    for arg in argv[1:]:
        if arg == '--':
            break
        if arg.startswith('--sasl-username='):
            login = arg.split('=', 1)[1]
        elif arg.startswith('--bindings='):
            path = arg.split('=', 1)[1]
    return login, path


def load_bindings(path):
    # No `except`: an unreadable or malformed file defers the message (EX_TEMPFAIL) instead of waving everything through.
    with open(path) as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise ValueError('bindings file is not a mapping')
    return data


RAW_FROM_FIELD = re.compile(r'(?i)^from[ \t]*:')


def raw_from_values(raw):
    """The unfolded value of every From field of the RAW header block (bytes up to the first blank line). Read from the raw
    bytes, not from the parsed message: Postfix and OpenDKIM take `From :` (a space before the colon) for a From field, while
    Python's parser does not, so `From : ceo@d` + `From: approvals@d` would show ONE From to a parsed-message check."""
    text = raw.decode('latin-1')
    end = re.search(r'(?:\A|\n)\r?\n', text)
    block = text if end is None else text[:end.start()]
    fields = []
    for line in re.split(r'\r?\n', block):
        if line[:1] in (' ', '\t') and fields:
            fields[-1] += ' ' + line.strip()
        else:
            fields.append(line)
    return [f.split(':', 1)[1].strip() for f in fields if RAW_FROM_FIELD.match(f)]


def binding_refusal(login, bindings, sender, raw):
    """Reason to refuse the message, or None. Only a login LISTED in `bindings` is checked (an unlisted one, such as the
    shared relay account, is left alone): the envelope sender and the From address must be bound to it, there must be exactly
    ONE From field, and no `@` or `<` may hide in a display name or a comment (a viewer shows that text as the sender)."""
    owned = bindings.get((login or '').lower())
    if owned is None:
        return None
    owned = {a.lower() for a in owned}
    if (sender or '').lower() not in owned:
        return 'envelope sender %r is not bound to this login' % sender
    values = raw_from_values(raw)
    if not values:
        return 'no From header'
    if len(values) > 1:
        return 'more than one From header'
    pairs = email.utils.getaddresses(values)
    from_addresses = [addr.lower() for _, addr in pairs if addr]
    if not from_addresses:
        return 'no From address'
    if values[0].count('@') != len(from_addresses) or values[0].count('<') > len(from_addresses):
        return 'From header carries an address-like text outside the address (display name or comment)'
    for addr in from_addresses:
        if addr not in owned:
            return 'From address %r is not bound to this login' % addr
    return None


def load_config():
    try:
        with open(CONFIG_FILE) as fh:
            return json.load(fh)
    except Exception:
        return {}


def extract_domain(header_value):
    m = re.search(r'@([\w.\-]+)', header_value or '')
    return m.group(1).lower() if m else ''


def apply_domain_config(msg, config):
    reply_to = config.get('reply_to', '')
    prefix = config.get('subject_prefix', '')

    if reply_to:
        del msg['Reply-To']
        msg['Reply-To'] = reply_to

    if prefix:
        subject = msg.get('Subject', '')
        if not subject.startswith(prefix):
            del msg['Subject']
            msg['Subject'] = prefix + subject

    return msg


def main():
    sender, recipients = parse_args(sys.argv)
    raw = sys.stdin.buffer.read()

    domain_config = load_config()
    msg = email.message_from_bytes(raw, policy=email.policy.compat32)

    login, bindings_path = parse_binding_args(sys.argv)
    if bindings_path is not None and login:
        reason = binding_refusal(login, load_bindings(bindings_path), sender, raw)
        if reason:
            sys.stderr.write('mailfilter refused: login=%s %s\n' % (login, reason))
            sys.exit(EX_DATAERR)

    from_domain = extract_domain(msg.get('From', ''))
    config = domain_config.get(from_domain, {})

    if config:
        msg = apply_domain_config(msg, config)

    modified = msg.as_bytes(policy=email.policy.compat32)

    try:
        with smtplib.SMTP(REINJECT_HOST, REINJECT_PORT, timeout=30) as smtp:
            smtp.sendmail(sender, recipients, modified)
    except smtplib.SMTPException as exc:
        sys.stderr.write(f'mailfilter SMTP error: {exc}\n')
        sys.exit(EX_TEMPFAIL)

    sys.exit(0)


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        sys.stderr.write(f'mailfilter error: {exc}\n')
        sys.exit(EX_TEMPFAIL)
