# Postfix check_sasl_access (texthash) — SASL logins whose sender is bound
# Generated by Ansible (mailrelay_sender_bindings) — DO NOT EDIT MANUALLY
# Result `bound_sender` is a restriction class (main.cf): reject_sender_login_mismatch.
{% set logins = [] %}
{% for binding in mailrelay_sender_bindings %}
{% set _ = logins.append((binding.login if '@' in binding.login else binding.login ~ '@' ~ mailrelay_hostname) | lower) %}
{% endfor %}
{% for login in logins | unique | sort %}
{{ login }} bound_sender
{% endfor %}
