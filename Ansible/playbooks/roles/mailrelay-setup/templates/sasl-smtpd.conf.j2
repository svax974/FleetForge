# Cyrus SASL config for Postfix smtpd
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# On garde le chemin PAR DÉFAUT de la base sasldb. Une version antérieure
# pointait vers /etc/postfix/sasl/saslpasswd.db : la bibliothèque Cyrus SASL
# ignorait ce réglage et retombait sur /etc/sasldb2, que l'utilisateur postfix
# ne pouvait pas lire — d'où des « SASL LOGIN authentication failed: generic
# failure » alors que l'utilisateur existait bel et bien.
pwcheck_method: auxprop
auxprop_plugin: sasldb
sasldb_path: /etc/sasldb2
mech_list: PLAIN LOGIN
