# Postfix smtpd_sender_login_maps (texthash) — envelope sender -> owning SASL login(s)
# Generated by Ansible (mailrelay_sender_bindings) — DO NOT EDIT MANUALLY
{% set owners = {} %}
{% for binding in mailrelay_sender_bindings %}
{% set login = (binding.login if '@' in binding.login else binding.login ~ '@' ~ mailrelay_hostname) | lower %}
{% for sender in ([binding.senders] if binding.senders is string else binding.senders) %}
{% set _ = owners.update({sender | lower: (owners.get(sender | lower, []) + [login]) | unique | list}) %}
{% endfor %}
{% endfor %}
{% for sender in owners | sort %}
{{ sender }} {{ owners[sender] | sort | join(',') }}
{% endfor %}
