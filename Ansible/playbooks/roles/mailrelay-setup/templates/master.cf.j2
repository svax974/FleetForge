# Postfix master.cf — Multi-domain SMTP relay
# Generated by Ansible — DO NOT EDIT MANUALLY
#
# Flow: client → 465/587 (no DKIM milter, content_filter=mailfilter)
#       → mailfilter.py adds Reply-To + Subject prefix per domain
#       → re-inject to 10026 (DKIM milter, no content_filter)
#       → OpenDKIM signs modified message → outbound delivery
#
# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
# ==========================================================================

# Port 25: restricted to localhost only (no inbound from internet)
smtp      inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtp25
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_milters=
  -o content_filter=

# Port 465: SMTPS (TLS wrapper) — authenticated relay
smtps     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_mynetworks,permit_sasl_authenticated,reject_unauth_destination
  -o smtpd_milters=
  -o content_filter=mailfilter:

# Port 587: Submission (STARTTLS) — authenticated relay
submission inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_mynetworks,permit_sasl_authenticated,reject_unauth_destination
  -o smtpd_milters=
  -o content_filter=mailfilter:

# Port 10026: re-injection after header rewrite — DKIM milter, no content_filter
# TLS disabled: localhost-only, and mailfilter.py uses plain smtplib.SMTP
127.0.0.1:10026 inet  n  -  n  -  -  smtpd
  -o syslog_name=postfix/reinjection
  -o content_filter=
  -o smtpd_tls_security_level=none
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o mynetworks=127.0.0.0/8

# ── Internal services ─────────────────────────────────────────────────────────
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
          -o syslog_name=postfix/$service_name
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd

# ── Header rewrite pipe transport ─────────────────────────────────────────────
mailfilter unix  -  n  n  -  10  pipe
  flags=Rq user=mailfilter null_sender=
  argv=/usr/local/lib/mailserver/mailfilter.py -f ${sender} -- ${recipient}
