#!/usr/bin/env python3
# Postfix after-queue content filter — per-domain Subject prefix + Reply-To injection.
# Reads raw message from stdin, modifies headers based on From domain config,
# re-injects to 127.0.0.1:10026 (OpenDKIM milter signs the modified message there).
# Generated by Ansible — DO NOT EDIT MANUALLY

import sys
import re
import json
import email
import email.policy
import smtplib

CONFIG_FILE = '/etc/postfix/mailserver-domains.json'
REINJECT_HOST = '127.0.0.1'
REINJECT_PORT = 10026
EX_TEMPFAIL = 75


def parse_args(argv):
    sender = ''
    recipients = []
    i = 1
    while i < len(argv):
        if argv[i] == '-f' and i + 1 < len(argv):
            sender = argv[i + 1]
            i += 2
        elif argv[i] == '--':
            recipients = argv[i + 1:]
            break
        else:
            i += 1
    return sender, recipients


def load_config():
    try:
        with open(CONFIG_FILE) as fh:
            return json.load(fh)
    except Exception:
        return {}


def extract_domain(header_value):
    m = re.search(r'@([\w.\-]+)', header_value or '')
    return m.group(1).lower() if m else ''


def apply_domain_config(msg, config):
    reply_to = config.get('reply_to', '')
    prefix = config.get('subject_prefix', '')

    if reply_to:
        del msg['Reply-To']
        msg['Reply-To'] = reply_to

    if prefix:
        subject = msg.get('Subject', '')
        if not subject.startswith(prefix):
            del msg['Subject']
            msg['Subject'] = prefix + subject

    return msg


def main():
    sender, recipients = parse_args(sys.argv)
    raw = sys.stdin.buffer.read()

    domain_config = load_config()
    msg = email.message_from_bytes(raw, policy=email.policy.compat32)

    from_domain = extract_domain(msg.get('From', ''))
    config = domain_config.get(from_domain, {})

    if config:
        msg = apply_domain_config(msg, config)

    modified = msg.as_bytes(policy=email.policy.compat32)

    try:
        with smtplib.SMTP(REINJECT_HOST, REINJECT_PORT, timeout=30) as smtp:
            smtp.sendmail(sender, recipients, modified)
    except smtplib.SMTPException as exc:
        sys.stderr.write(f'mailfilter SMTP error: {exc}\n')
        sys.exit(EX_TEMPFAIL)

    sys.exit(0)


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        sys.stderr.write(f'mailfilter error: {exc}\n')
        sys.exit(EX_TEMPFAIL)
