# Postfix main.cf — Multi-domain SMTP relay
# Generated by Ansible — DO NOT EDIT MANUALLY

# ── Identity ──────────────────────────────────────────────────────────────────
myhostname = {{ mailserver_hostname }}
myorigin   = $myhostname
mydestination = localhost, $myhostname
mynetworks  = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
inet_interfaces = all
inet_protocols  = ipv4

# ── Relay ─────────────────────────────────────────────────────────────────────
relay_domains =
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

# ── TLS — server (SMTPS / submission) ─────────────────────────────────────────
# Default cert for clients that don't send SNI
smtpd_tls_cert_file = /etc/letsencrypt/live/{{ mail_domains[0].name }}/fullchain.pem
smtpd_tls_key_file  = /etc/letsencrypt/live/{{ mail_domains[0].name }}/privkey.pem
smtpd_tls_CApath    = /etc/ssl/certs
# Per-domain SNI: servername → privkey certchain
tls_server_sni_maps = texthash:/etc/postfix/tls_sni_map
smtpd_tls_security_level       = encrypt
smtpd_tls_auth_only            = yes
smtpd_tls_protocols            = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtpd_tls_mandatory_protocols  = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtpd_tls_ciphers              = high
smtpd_tls_mandatory_ciphers    = high
smtpd_tls_loglevel             = 1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache

# ── TLS — client (outbound delivery) ─────────────────────────────────────────
smtp_tls_security_level = may
smtp_tls_protocols      = !SSLv2,!SSLv3,!TLSv1,!TLSv1.1
smtp_tls_loglevel       = 1
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# ── SASL ──────────────────────────────────────────────────────────────────────
smtpd_sasl_type             = cyrus
smtpd_sasl_path             = smtpd
smtpd_sasl_auth_enable      = yes
smtpd_sasl_local_domain     = $myhostname
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous
broken_sasl_auth_clients    = yes

# ── DKIM milter (applied at re-injection port 10026, after header rewrite) ────
milter_protocol       = 6
milter_default_action = accept
smtpd_milters         = unix:/run/opendkim/opendkim.sock
non_smtpd_milters     = unix:/run/opendkim/opendkim.sock

# ── Content filter — header rewrite (Subject prefix + Reply-To per domain) ───
# Applied on submission ports; re-injection on 10026 bypasses this filter.
content_filter = mailfilter:

# ── Queue ─────────────────────────────────────────────────────────────────────
maximal_queue_lifetime = 1d
bounce_queue_lifetime  = 6h
message_size_limit     = 52428800
# Doit rester >= message_size_limit : sinon le livreur `local` refuse de
# démarrer (« mailbox_size_limit is smaller than message_size_limit ») et
# boucle en échec. Le défaut de Postfix (51200000) est PLUS PETIT que les
# 50 Mio ci-dessus — constat du 24/10/2026 sur mail1 (web3c) : postfix@- en
# échec depuis le 18/10, ~10 000 erreurs par heure. 1 Gio plutôt que 0
# (illimité) : une mbox locale (root, cron) qui grossit sans fin finirait par
# remplir le disque.
mailbox_size_limit     = 1073741824

# ── Misc ──────────────────────────────────────────────────────────────────────
smtpd_banner        = $myhostname ESMTP
biff                = no
append_dot_mydomain = no
readme_directory    = no
compatibility_level = 3.6
