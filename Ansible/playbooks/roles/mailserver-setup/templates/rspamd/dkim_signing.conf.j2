# rspamd — signature DKIM des messages sortants. Généré par Ansible (mailserver-setup).
# Une clé par domaine : /var/lib/rspamd/dkim/<domaine>.<sélecteur>.key
path = "/var/lib/rspamd/dkim/$domain.$selector.key";
selector = "{{ mailserver_dkim_selector }}";
# L'expéditeur authentifié (alice@example.com) signe pour son domaine.
allow_username_mismatch = true;
sign_authenticated = true;
sign_local = true;
use_domain = "header";
