{# ── Application WebAppTemplate : vhost GÉNÉRIQUE ─────────────────────────────
   Rendu par `deploy-webapp-site.yml` (et par la resynchronisation complète de
   tasks/main.yml) pour UN nom public, à partir des entrées d'inventaire qui le
   portent (`webapp_vhost_entries`) — jamais d'un fichier de parc. Un vhost écrit
   à la main, `parcs/<parc>/nginx/sites-enabled/<projet>.conf`, a TOUJOURS la
   priorité : c'est la porte de sortie des applications aux besoins propres
   (WebSocket, git smart-HTTP, webhooks privés, limites par zone…).

   Deux modes de front, selon `cloudflare_front` de l'entrée (voir cloudflare-pages-setup) :
   - false : front en conteneur ; `proxy_hostname` → `app_port` (son nginx interne
     relaie /api/ vers le back) ;
   - true  : front sur Cloudflare Pages, qui ne passe PAS par les proxies ; ce
     vhost n'est que l'API, `<projet>-back.<domaine>` → `back_port` (back-lb).
   `cloudflare_named: true` est un attribut DISTINCT, sans effet sur le front : le nom
   public (`proxy_hostname`) est servi par l'edge Cloudflare (enregistrement proxifié),
   le front reste en conteneur derrière les proxies — même `server_name` et mêmes
   amonts que sans l'attribut, plus `_cloudflare_front.inc` (IP réelle, Authenticated
   Origin Pulls).
   Accès : `access_mode` de l'entrée (_access.inc : privé par défaut) ; avec
   `cloudflare_front` ou `cloudflare_named`, public = joignable seulement par NOTRE
   Cloudflare (certificat client, `_cloudflare_front.inc`), et privé = refus (403) d'une
   socket d'une plage Cloudflare SANS certificat client vérifié (CF-Connecting-IP forgeable
   par tout client Cloudflare : `geo` + `map` de `_cloudflare_untrusted.inc`) + `no-store`.
   Plusieurs entrées pour un même nom (ex. deux back de prod) : un `upstream`.
   Blocs supplémentaires : `webapp_vhost_locations` sur la première entrée, une
   liste de { path, regex?, mode?, ws?, body?, timeout?, buffering?, upstream?,
   priority?, access? } : `upstream: back` relaie au back-lb (`back_port`),
   `priority: true` pose `^~`, `access` remplace le mode par une liste NOMMÉE
   (`_named_access.inc` : serveurs nommés, whitelist filtrée, adresses VPN
   écartées, puis `deny all`).
   X-Forwarded-For RÉÉCRIT (`$remote_addr`, jamais complété) dans toutes les locations
   avec le profil durci (`webapp_hardening`), `cloudflare_named` OU `cloudflare_front` ;
   sinon complété (`$proxy_add_x_forwarded_for`), comme avant.
   Profil durci (`webapp_hardening` sur l'entrée) : de plus, amont en
   127.0.0.1 sur le proxy co-localisé (le pare-feu de l'app n'admet que les
   proxies DISTANTS), et AUCUN vhost sur un proxy à l'adresse d'un serveur VPN.
   Sans profil ni attribut Cloudflare : rendu inchangé. #}
{% set _first = webapp_vhost_entries | first %}
{% set _h = hostvars[_first] %}
{% set _hardened = _h.webapp_hardening is defined %}
{% set _vpn_addresses = groups['vpns'] | default([]) | map('extract', hostvars, 'ansible_host') | list %}
{% set _pages = _h.cloudflare_front | default(false) | bool %}
{% set _named = _h.cloudflare_named | default(false) | bool %}
{# X-Forwarded-For RÉÉCRIT (`$remote_addr`, jamais complété) pour un nom durci, servi par Cloudflare (`cloudflare_named`) ou à API sur
   Pages (`cloudflare_front`) : `$remote_addr` est alors l'adresse réelle (real_ip depuis CF-Connecting-IP), et un X-Forwarded-For fourni
   par le client, qu'`$proxy_add_x_forwarded_for` conserverait en tête de chaîne, n'atteint pas l'application. Les autres noms : inchangé. #}
{% set _xff = '$remote_addr' if (_hardened or _named or _pages) else '$proxy_add_x_forwarded_for' %}
{% set _project = (_h.webapp_project | default(_first)) | lower | replace('_', '-') %}
{% set _server_name = (_project ~ '-back.' ~ domain_name) if _pages else _h.proxy_hostname %}
{% set _slug = _server_name | regex_replace('[^a-z0-9]', '_') %}
{% set access_entry = _first %}
{# Variable nginx PROPRE à ce vhost (deux noms proxifiés ne doivent pas déclarer deux fois la même) : lue par `_access.inc` et
   `_named_access.inc` pour une entrée `cloudflare_named` OU `cloudflare_front`, définie par le `geo` + `map` posés avant le
   `server {}` ci-dessous (`_cloudflare_untrusted.inc`). #}
{% set cf_untrusted_var = 'cf_untrusted_' ~ _slug %}
{% if _hardened and ansible_host in _vpn_addresses %}
# {{ _server_name }} : aucun vhost sur ce proxy (son adresse est celle d'un serveur VPN ; profil durci).
{% else %}
{% set _backends = [] %}
{% set _backends_back = [] %}
{% for _e in webapp_vhost_entries %}
{% set _addr = '127.0.0.1' if (_hardened and hostvars[_e].ansible_host == ansible_host) else hostvars[_e].ansible_host %}
{% set _port = (hostvars[_e].back_port | default(hostvars[_e].app_port | int + 1)) if _pages else hostvars[_e].app_port %}
{% set _ = _backends.append(_addr ~ ':' ~ _port) %}
{% set _ = _backends_back.append(_addr ~ ':' ~ (hostvars[_e].back_port | default(hostvars[_e].app_port | int + 1))) %}
{% endfor %}
{% set _upstream = ('webapp_' ~ _slug) if (_backends | length > 1) else ('http://' ~ _backends[0]) %}
{% set _upstream_back = ('webapp_' ~ _slug ~ '_back') if (_backends_back | length > 1) else ('http://' ~ _backends_back[0]) %}
{% set _wants_back = (_h.webapp_vhost_locations | default([]) | selectattr('upstream', 'defined') | selectattr('upstream', 'equalto', 'back') | list | length) > 0 %}
# {{ _server_name }} → {{ _backends | join(', ') }} ({{ 'API seule, front sur Cloudflare Pages' if _pages else ('front en conteneur, nom servi par Cloudflare' if _named else 'front en conteneur') }})
{% if _backends | length > 1 %}
upstream webapp_{{ _slug }} {
{% for _b in _backends %}
    server {{ _b }} max_fails=3 fail_timeout=10s;
{% endfor %}
}
{% endif %}
{% if _wants_back and _backends_back | length > 1 %}
upstream webapp_{{ _slug }}_back {
{% for _b in _backends_back %}
    server {{ _b }} max_fails=3 fail_timeout=10s;
{% endfor %}
}
{% endif %}

{% if _named or _pages %}
{# `geo` + `map` partagés avec les vhosts écrits à la main (agenthub.conf) : `_cloudflare_untrusted.inc`, même mécanisme pour
   `cloudflare_named` ET `cloudflare_front`. Le partiel perd sa fin de ligne finale : remise ici, avec la ligne vide qui suit. #}
{% set cf_slug = _slug %}
{% include '_cloudflare_untrusted.inc' %}{{ '\n\n' -}}
{% endif %}
server {
    listen      80;
    listen      [::]:80;
    server_name {{ _server_name }};
    return 301 https://$host$request_uri;
}

server {
{% if nginx_version is version('1.25.1', '>=') %}
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
{% else %}
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
{% endif %}
    server_name {{ _server_name }};
{% if _pages or _named %}
    {% include '_cloudflare_front.inc' %}
{% endif %}

    ssl_certificate     /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;
{% for _l in _h.webapp_vhost_locations | default([]) %}

    location {{ '^~ ' if _l.priority | default(false) else '' }}{{ '~* ' if _l.regex | default(false) else '' }}{{ _l.path }} {
{% if _l.raw_uri is defined %}
        # nginx choisit la location sur l'URI NORMALISÉE (`/x/../mcp` → `/mcp`) mais relaie l'URI BRUTE : refusée si
        # elle n'a pas la forme attendue.
        if ($request_uri !~* "{{ _l.raw_uri }}") {
            return 400;
        }
{% endif %}
{% if _l.access is defined %}
{% set named_access = _l.access %}
{# Le partiel perd sa fin de ligne finale au rendu : la remettre, sinon `deny all;` et `proxy_pass` partagent une ligne. #}
{% include '_named_access.inc' %}{{ '\n' -}}
{% else %}
        {% set access_mode_local = _l.mode | default(none) %}
        {% include '_access.inc' %}
{% endif %}
        proxy_pass         {{ _upstream_back if (_l.upstream | default('front')) == 'back' else _upstream }};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For {{ _xff }};
        proxy_set_header   X-Forwarded-Proto $scheme;
{% if _l.ws | default(false) %}
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
{% endif %}
{% if _l.body is defined %}
        client_max_body_size    {{ _l.body }};
        proxy_request_buffering off;
{% endif %}
{% if _l.buffering is defined and not _l.buffering %}
        proxy_buffering    off;
{% endif %}
{% if _l.timeout is defined %}
        proxy_read_timeout {{ _l.timeout }};
        proxy_send_timeout {{ _l.timeout }};
{% endif %}
    }
{% endfor %}

    location / {
        {% set access_mode_local = none %}
        {% include '_access.inc' %}
        proxy_pass         {{ _upstream }};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For {{ _xff }};
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
    }
}
{% endif %}
