[Unit]
Description=PapangMetrics ETL worker (BRK -> TimescaleDB)
After=network-online.target
Wants=network-online.target

# Voir brk.service : sans fenêtre explicite, RestartSec dépasse le défaut de 10 s
# et la limite ne se déclenche jamais — une boucle de crash resterait `active`.
StartLimitIntervalSec={{ pm_start_limit_interval }}
StartLimitBurst={{ pm_start_limit_burst }}

[Service]
Type=simple
User={{ pm_user }}
Group={{ pm_user }}
WorkingDirectory={{ pm_dir }}
EnvironmentFile={{ pm_dir }}/.env
ExecStart=/usr/bin/node {{ pm_dir }}/dist/main.etl.js
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
