#!/bin/bash
# Règles de pare-feu du port TimescaleDB — géré par Ansible, ne pas éditer.
#
# PostgreSQL tourne dans un conteneur avec un port publié : Docker insère ses
# règles DNAT en amont de la chaîne INPUT, donc ufw ne voit jamais ce trafic.
# `DOCKER-USER` est la seule chaîne que Docker traverse sans la réécrire.
#
# Rejoué au démarrage par timescaledb-firewall.service, APRÈS docker.service :
# Docker recrée DOCKER-USER vide à chaque démarrage, une sauvegarde
# iptables-persistent serait donc restaurée trop tôt puis écrasée. (Et sur cette
# distribution `iptables-persistent` et `ufw` se désinstallent mutuellement.)
set -euo pipefail

PORT={{ tsdb_port }}
INTERNAL="{{ tsdb_docker_internal_cidr }}"
ALLOWED=({{ (tsdb_allowed_ips + tsdb_extra_allowed_cidrs + tsdb_peer_ips) | unique | join(' ') }})

# Purge des règles existantes pour ce port — rend le script idempotent et
# élimine les doublons laissés par les ajouts manuels antérieurs.
#
# Suppression par NUMÉRO de règle, et non par spécification : réinjecter une
# spec contenant `--comment "TimescaleDB - allowed source"` la fait découper par
# le shell, et iptables rejette le tiret isolé (« Bad argument `-' »).
while true; do
  N=$(iptables -L DOCKER-USER --line-numbers -n 2>/dev/null \
      | awk -v p="dpt:${PORT}" '$0 ~ p {print $1; exit}')
  [ -z "${N}" ] && break
  iptables -D DOCKER-USER "${N}"
done

# Sources autorisées d'abord : elles doivent précéder le DROP final.
for SRC in "${ALLOWED[@]}"; do
  iptables -A DOCKER-USER -s "${SRC}" -p tcp --dport "${PORT}" \
    -m comment --comment "TimescaleDB - allowed source" -j RETURN
done

# Trafic issu des conteneurs de CETTE machine : le réplica joint son primaire, les outils (réconciliateur,
# arbitre) joignent le pair. Une source externe n'a jamais une adresse de ce réseau privé.
iptables -A DOCKER-USER -s "${INTERNAL}" -p tcp --dport "${PORT}" \
  -m comment --comment "TimescaleDB - local containers" -j RETURN

iptables -A DOCKER-USER -p tcp --dport "${PORT}" \
  -m comment --comment "TimescaleDB - deny external" -j DROP
