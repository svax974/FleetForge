[Unit]
Description=Restrict the TimescaleDB published port to authorized sources
# Docker recrée la chaîne DOCKER-USER vide à chaque démarrage : les règles
# doivent être reposées APRÈS lui, sans quoi la base est exposée à Internet
# entre le démarrage de Docker et l'intervention manuelle.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/timescaledb-firewall.sh

[Install]
WantedBy=multi-user.target
