# ═════════════════════════════════════════════════════════════════════════════
# Modèle d'inventaire d'un PARC — versionné, données FICTIVES uniquement.
#
# Usage :
#   cp inventories/parc_inventory.yml.template inventories/<parc>_inventory.yml
#   puis renommer le groupe racine `monparc` en <parc> (doit correspondre à
#   playbooks/group_vars/<parc>.yml, cf. parc.yml.template) et remplacer les
#   adresses. Les inventaires réels sont gitignorés.
#
# Un parc = l'UNION des fichiers inventories/<parc>_*.yml (CLAUDE.md § 2).
# Un même nom d'hôte dans deux fichiers d'un parc est interdit.
#
# Adresses de documentation (RFC 5737) : 203.0.113.0/24, 198.51.100.0/24.
#
# Variables d'hôte reconnues :
#   ansible_host     adresse de la MACHINE (même adresse = même machine)
#   ansible_port     port SSH, s'il diffère de `ssh_custom_port` (NAT : un port par machine)
#   provider         hébergeur — gcp | aws | contabo | ovh | oracle | custom (OBLIGATOIRE, sans défaut)
#   ansible_roles    familles de service déployées (TOUJOURS une liste)
#   hostname         nom DNS de la machine (A record) ; `<service>-priv` sur une entrée dédiée
#   proxy_hostname   nom PUBLIC servi par les proxies (CNAME → proxy.<domaine>)
#   app_port         port du service publié (unique par entrée)
#   back_port        port du back d'une application front+back
#   access_mode      private (défaut) | public — filtrage du vhost (_access.inc)
#   access_linked    entrées autorisées en plus sur un vhost privé (serveurs liés)
#   access_local_cidrs sous-réseaux Docker PRIVÉS (/16 à /32) d'un serveur lié,
#                    admis seulement par un proxy de la MÊME machine que lui
#   server_type      proxy | monitoring | vpn | db | backup | app | misc (affichage)
#   monitor_port     port de scrape node_exporter public (NAT domestique)
#   svcprobe_port    port de scrape svcprobe public (NAT domestique)
#   monitor: "off"   machine non supervisée
#   alert_exclude    alertes Prometheus dont l'entrée est exemptée, par nom de
#                    règle : [DiskWillFillSoon] (prometheus-alerts-update,
#                    `./play.sh <parc> update-prometheus-alerts.yml`)
#   initial_ssh_pass 🔒 mot de passe root d'une machine vierge (vault)
# ═════════════════════════════════════════════════════════════════════════════
all:
  vars:
    # Défaut obligatoire ici, pas dans group_vars/all.yml (gitignoré).
    ansible_roles: []
  children:
    monparc:
      children:

        # ── Frontaux nginx : vhosts de tous les services publiés ──────────────
        proxies:
          hosts:
            proxy1:
              hostname: proxy1.{{ domain_name }}
              ansible_host: 203.0.113.10
              provider: contabo
              server_type: proxy
              ansible_roles: [proxy]
            proxy2:
              hostname: proxy2.{{ domain_name }}
              ansible_host: 198.51.100.20            # NAT domestique
              ansible_port: 22
              provider: custom
              server_type: proxy
              ansible_roles: [proxy]

        # ── Supervision : nom à reporter dans `prometheus_host` ───────────────
        prometheus:
          hosts:
            monitor:
              hostname: monitoring.{{ domain_name }}
              ansible_host: 203.0.113.10
              provider: contabo
              server_type: monitoring
              app_port: 9090
              ansible_roles: [monitoring]

        vpns:
          hosts:
            vpn1:
              hostname: vpn1.{{ domain_name }}
              ansible_host: 198.51.100.20
              ansible_port: 22
              provider: custom
              server_type: vpn
              proxy_hostname: vpn.{{ domain_name }}
              ansible_roles: [vpn]

        misc:
          hosts:
            # Entrée CANONIQUE d'une machine : ses familles non publiées.
            alertmanager1:
              hostname: alertmanager1.{{ domain_name }}
              ansible_host: 203.0.113.10
              provider: contabo
              server_type: monitoring
              ansible_roles: [alertmanager]
            mail1:
              hostname: mail.{{ domain_name }}
              ansible_host: 203.0.113.10
              provider: contabo
              server_type: misc
              ansible_roles: [mailrelay, dmarc-exporter]

            # Machine derrière un NAT domestique : identifiée par adresse + port
            # SSH, ports de scrape redirigés par le routeur.
            hub:
              hostname: hub.srv.{{ domain_name }}
              ansible_host: 198.51.100.20
              ansible_port: 1220
              provider: custom
              monitor_port: 9101
              svcprobe_port: 9111
              ansible_roles: []

            # Entrée DÉDIÉE d'un service publié : identité de la machine
            # recopiée (ansible_host, ansible_port, provider, ports de scrape).
            ollama:
              hostname: ollama-priv.{{ domain_name }}
              proxy_hostname: ollama.{{ domain_name }}
              ansible_host: 198.51.100.20
              ansible_port: 1220
              provider: custom
              monitor_port: 9101
              svcprobe_port: 9111
              app_port: 11434
              access_mode: private
              ansible_roles: [ollama]

            # Machine vierge : le premier setup-server.yml se connecte en root.
            small1:
              ansible_host: 203.0.113.30
              provider: oracle
              server_type: misc
              # initial_ssh_pass: !vault |
              #   $ANSIBLE_VAULT;1.1;AES256 …

        # ── Application front + back, avec sauvegarde PostgreSQL off-host ─────
        apps:
          hosts:
            monapp:
              hostname: monapp-priv.{{ domain_name }}
              proxy_hostname: monapp.{{ domain_name }}
              ansible_host: 203.0.113.40
              provider: ovh
              app_port: 4300
              back_port: 4301
              server_type: app
              access_mode: public
              ansible_roles: [monapp, backup]
              pgbak_name: monapp                     # label `backup` des métriques
              pgbak_container: monapp_postgres
              pgbak_db: monapp
              pgbak_user: monapp
              pgbak_dest_host: backup-monapp         # entrée du groupe `backups`
              pgbak_cron_minute: "10"

        # ── Passerelle MCP de FleetForge (deploy-fleetforge.yml, tag gateway) ──
        # Entrée `webapp` DURCIE (`webapp_hardening`, docs/etude-passerelle-sur-
        # webapp.md), DÉDIÉE, jamais dans `infras` ni avec la famille
        # `fleetforge` (même quand elle partage la machine de FleetForge :
        # copier alors son ansible_host/provider). Son amont (une entrée de
        # `infras`) la nomme dans `access_linked` et porte dans
        # `ff_api_accounts` les comptes bornés ffg_read (read), ffg_check (check,
        # max_hosts, allow_playbooks = update-prometheus-alerts.yml +
        # check-monitoring.yml, deny_playbooks ⊇ ffg_required_denies) et ffg_run
        # (run, idem, accept_checks_from: [ffg_check], accept_own_checks: false)
        # — vérifié par le play de garde, sans connexion.
        fleetforge_gateways:
          hosts:
            fleetforge-gateway:
              hostname: ffg-priv.{{ domain_name }}
              proxy_hostname: ffg.{{ domain_name }}
              ansible_host: 203.0.113.50
              provider: ovh
              server_type: app
              app_port: 4730        # front (publié 4730:80) ; Postgres 4732, Redis 4733 (dérivés)
              back_port: 4731       # back-lb : sert /mcp
              access_mode: private  # E1 : jamais public
              ufw_app_ports: false  # ports publiés par Docker : DOCKER-USER seulement
              ansible_roles: [webapp, backup]
              webapp_db_engine: postgres
              webapp_update_common: false
              # Sauvegarde de SA base (famille `backup`, deploy-backup.yml ; docs/etude-passerelle-sur-webapp.md,
              # « Sauvegarde de la base de la passerelle »). Conteneur = `<projet>_postgres` (projet = nom de l'entrée) ;
              # base et rôle = ceux du back/.env (défaut `webapp` : le nom du projet sans tiret) ; destination = une
              # entrée de `backups` sur une AUTRE machine ; `pgbak_dir` propre à l'entrée (le défaut est partagé par
              # toutes les entrées d'une machine) ; seuil BackupStale : `prom_alert_backup_max_age_hours`.
              # Contrôlé sans connexion par la garde de deploy-fleetforge.yml (tag gateway).
              pgbak_name: fleetforge-gateway
              pgbak_container: fleetforge-gateway_postgres
              pgbak_db: fleetforgegateway
              pgbak_user: fleetforgegateway
              pgbak_dest_host: backup-fleetforge-gateway
              pgbak_dir: "/home/{{ remote_username }}/postgres-backup-fleetforge-gateway"
              pgbak_cron_minute: "20"
              # Sous-réseau Docker dédié (HARDEN_SUBNET du compose durci), hors
              # 172.16/12 et 192.168/16 ; admis par le vhost de l'amont sur un
              # proxy CO-LOCALISÉ (`access_local_cidrs`).
              webapp_hardening:
                runtime_user: ffgateway
                docker_subnet: 10.73.231.0/24
                front_ip: 10.73.231.10
                back_lb_ip: 10.73.231.11
                protected_paths: ["/run/fleetforge"]
                # Sorties du sous-réseau (tout le reste refusé) : l'amont par les proxies, le relais SMTP du parc.
                egress_allow:
                  - { name: upstream, proxies: true, port: 443 }
                  - { name: smtp, inventory_host: mail1, port: 587 }
              access_local_cidrs: [10.73.231.0/24]
              # /mcp : seuls ces serveurs (vide = personne), puis deny all.
              # `whitelist: true` = accès de TEST (false hors tests, et avant
              # toute exposition E2/E3) ; adresses VPN toujours écartées.
              webapp_vhost_locations:
                - { path: '^/mcp(/.*)?$', regex: true, upstream: back, body: 128k, buffering: false, timeout: 180s,
                    raw_uri: '^/mcp(/|[?]|$)', access: { hosts: [infra1], whitelist: false } }
                - { path: /.well-known/, priority: true, access: { hosts: [] } }
              ffg_upstreams:
                - { id: main, entry: infra1, parcs: [monparc] }
              webapp_env_from_vault:
                FFG_UPSTREAM_MAIN_READ_PASSWORD: ff_api_password_ffg_read
                FFG_UPSTREAM_MAIN_CHECK_PASSWORD: ff_api_password_ffg_check
                FFG_UPSTREAM_MAIN_RUN_PASSWORD: ff_api_password_ffg_run
              webapp_env_required: [FFG_UPSTREAMS, REDIS_PASSWORD]
              webapp_extra_secrets:
                - { key: REDIS_PASSWORD, kind: hex_32 }
              webapp_upstream_checks:
                - { id: main, url: "https://infra.{{ domain_name }}/healthz" }

        # ── Destinations de sauvegarde (une entrée par sauvegarde) ────────────
        backups:
          hosts:
            backup-monapp:
              hostname: backup-monapp.{{ domain_name }}
              ansible_host: 203.0.113.10
              provider: contabo
              server_type: backup
              backup_sources: [monapp]
              ansible_roles: [backup]

            # Destination de la base de la passerelle : JAMAIS la machine de la passerelle.
            backup-fleetforge-gateway:
              hostname: backup-ffg.{{ domain_name }}
              ansible_host: 203.0.113.60
              provider: contabo
              server_type: backup
              backup_sources: [fleetforge-gateway]
              ansible_roles: [backup]
